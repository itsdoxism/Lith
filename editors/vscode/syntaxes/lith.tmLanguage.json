{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Lith",
  "scopeName": "source.lith",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#operators" },
    { "include": "#builtins" },
    { "include": "#constants" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.lith",
          "begin": "#",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.lith" }
          },
          "end": "$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.single.lith",
          "begin": "'",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.lith" }
          },
          "end": "'",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.lith" }
          },
          "patterns": [
            {
              "name": "constant.character.escape.lith",
              "match": "\\\\(?:[nrt'\\\\]|x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4})"
            },
            {
              "name": "variable.other.interpolation.lith",
              "match": "\\[[A-Za-z_][A-Za-z0-9_.]*\\]"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.lith",
          "match": "\\b[0-9]+\\.[0-9]+(?:[eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.lith",
          "match": "\\b(?:0x[0-9A-Fa-f]+|0b[01]+|[0-9]+)\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.function.lith" },
            "2": { "name": "entity.name.function.lith" }
          }
        },
        {
          "match": "\\b(struct)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.struct.lith" },
            "2": { "name": "entity.name.type.struct.lith" }
          }
        },
        {
          "match": "\\b(use)\\s+('(?:\\\\.|[^'])*'|[A-Za-z_][A-Za-z0-9_.]*)",
          "captures": {
            "1": { "name": "keyword.control.import.lith" },
            "2": { "name": "string.unquoted.import-path.lith" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.lith",
          "match": "\\b(?:if|else|while|loop|in|match|is|return|break|continue|use|struct|fn)\\b"
        },
        {
          "name": "keyword.other.memory.lith",
          "match": "\\b(?:alloc|realloc|free)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.lith",
          "match": "\\b(?:int|float|bool|char|str|bytes|ptr|null)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.word.lith",
          "match": "\\b(?:add|sub|mul|div|mod|eq|ne|gt|lt|ge|le|and|or|not|as)\\b"
        },
        {
          "name": "keyword.operator.assignment.lith",
          "match": "="
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.lith",
          "match": "\\b(?:io|fs|path|process|bytes|str|int|sys)\\.[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.lith",
          "match": "\\b(?:true|false)\\b"
        },
        {
          "name": "constant.language.null.lith",
          "match": "\\bnull\\b"
        }
      ]
    }
  }
}
