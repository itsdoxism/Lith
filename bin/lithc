#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
COMPILER="$ROOT/build/lithc"
BUILDER="$ROOT/build/lith-build"
SEED="$ROOT/bootstrap/seed/lithc-linux-x86_64"

if [ ! -x "$COMPILER" ]; then
  if [ -x "$BUILDER" ]; then
    echo 'Lith compiler missing; rebuilding with Lith-native builder...' >&2
    (cd "$ROOT" && "$BUILDER")
  elif [ -x "$SEED" ]; then
    echo 'Lith compiler missing; trusted seed exists but Lith-native builder is not built.' >&2
    echo 'Bootstrap the builder from the trusted seed; Python recovery is disabled.' >&2
    exit 2
  else
    echo 'Lith compiler is not bootstrapped.' >&2
    echo 'A trusted Lith seed is required; Python recovery is disabled.' >&2
    exit 2
  fi
fi

exec "$COMPILER" "$@"
