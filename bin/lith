#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
NATIVE_DRIVER="$ROOT/build/lith-driver"
SEED="$ROOT/bootstrap/seed/lithc-linux-x86_64"

if [ -x "$NATIVE_DRIVER" ]; then
  cd "$ROOT"
  exec "$NATIVE_DRIVER" "$@"
fi

if [ -x "$SEED" ]; then
  echo 'Lith native driver is not built yet.' >&2
  echo 'Bootstrap the Lith-native builder/driver from the trusted seed.' >&2
  exit 2
fi

echo 'Lith native driver is unavailable.' >&2
echo 'A trusted Lith seed is required; shell/Python recovery is disabled.' >&2
exit 2
