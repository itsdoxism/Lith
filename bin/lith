#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
CLANG=${CLANG:-clang}
RUNTIME="$ROOT/runtime/luna_runtime.ll"
BYTES_RUNTIME="$ROOT/runtime/lith_bytes.ll"
FS_RUNTIME="$ROOT/runtime/lith_fs.ll"
FS_POSIX_RUNTIME="$ROOT/runtime/lith_fs_posix.ll"
PATH_RUNTIME="$ROOT/runtime/lith_path.ll"

usage() {
  echo "usage: $0 input.lith [-o output] [--emit-llvm path] [-O0|-O1|-O2|-O3|--release] [--native]" >&2
  exit 2
}

[ "$#" -ge 1 ] || usage
INPUT=$1
shift
OUTPUT=''
EMIT=''
OPT='-O2'
NATIVE=''

while [ "$#" -gt 0 ]; do
  case "$1" in
    -o)
      [ "$#" -ge 2 ] || usage
      OUTPUT=$2
      shift 2
      ;;
    --emit-llvm)
      [ "$#" -ge 2 ] || usage
      EMIT=$2
      shift 2
      ;;
    -O0|-O1|-O2|-O3)
      OPT=$1
      shift
      ;;
    --release)
      OPT='-O3'
      shift
      ;;
    --native)
      NATIVE='-march=native'
      shift
      ;;
    *) usage ;;
  esac
done

if [ -z "$OUTPUT" ]; then
  base=$(basename -- "$INPUT")
  OUTPUT=${base%.lith}
fi

if [ -n "$EMIT" ]; then
  "$ROOT/bin/lithc" "$INPUT" "$EMIT"
  exit 0
fi

TMP=${TMPDIR:-/tmp}/lith-$$.ll
trap 'rm -f "$TMP"' EXIT HUP INT TERM

"$ROOT/bin/lithc" "$INPUT" "$TMP"
if [ -n "$NATIVE" ]; then
  "$CLANG" -Wno-override-module "$OPT" "$NATIVE" "$TMP" "$RUNTIME" "$BYTES_RUNTIME" "$FS_RUNTIME" "$FS_POSIX_RUNTIME" "$PATH_RUNTIME" -o "$OUTPUT"
else
  "$CLANG" -Wno-override-module "$OPT" "$TMP" "$RUNTIME" "$BYTES_RUNTIME" "$FS_RUNTIME" "$FS_POSIX_RUNTIME" "$PATH_RUNTIME" -o "$OUTPUT"
fi
