#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
CLANG=${CLANG:-clang}
RUNTIME="$ROOT/runtime/luna_runtime.ll"

usage() {
  echo "usage: $0 input.luna [-o output] [--emit-llvm path]" >&2
  exit 2
}

[ "$#" -ge 1 ] || usage
INPUT=$1
shift
OUTPUT=''
EMIT=''

while [ "$#" -gt 0 ]; do
  case "$1" in
    -o)
      [ "$#" -ge 2 ] || usage
      OUTPUT=$2
      shift 2
      ;;
    --emit-llvm)
      [ "$#" -ge 2 ] || usage
      EMIT=$2
      shift 2
      ;;
    *) usage ;;
  esac
done

if [ -z "$OUTPUT" ]; then
  base=$(basename -- "$INPUT")
  OUTPUT=${base%.luna}
fi

if [ -n "$EMIT" ]; then
  "$ROOT/bin/lunac" "$INPUT" "$EMIT"
  exit 0
fi

TMP=${TMPDIR:-/tmp}/luna-$$.ll
trap 'rm -f "$TMP"' EXIT HUP INT TERM

"$ROOT/bin/lunac" "$INPUT" "$TMP"
"$CLANG" -Wno-override-module -O2 "$TMP" "$RUNTIME" -o "$OUTPUT"
