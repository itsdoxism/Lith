fn main [] int [
    str data = io.read_text 'benchmarks/input.txt'
    int n = str.len data
    int limit = n mul 5000
    arr values = [1, 2, 3, 4, 5, 6, 7, 8]
    int i = 0
    int sum = 0
    while [i lt limit] [
        int idx = i mod 8
        int x = values[idx]
        int tmp = sum add x
        sum = tmp mod 1000000007
        values[idx] = x add 1
        i = i add 1
    ]
    io.print 'sum: [sum]'
    = 0
]
