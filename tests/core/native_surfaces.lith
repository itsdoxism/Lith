use fs
use bytes
use process

fn main [int argc, ptr str argv] int [
    if [argc lt 1] [ = 9 ]
    if [not argv[0]] [ = 8 ]

    str path = '/tmp/lith-native-surfaces.txt'
    int wrote = fs.write_text path, 'Lith bytes'
    if [wrote eq 0] [ = 10 ]

    str text = fs.read_text path
    if [not text] [ = 11 ]
    if [bytes.len text ne 10] [ = 12 ]
    if [bytes.at text, 0 ne 76] [ = 13 ]

    str head = bytes.slice text, 0, 4
    if [bytes.eq head, 'Lith' eq 0] [ = 14 ]

    str joined = bytes.concat head, ' native'
    if [bytes.eq joined, 'Lith native' eq 0] [ = 15 ]

    str path_env = process.env 'PATH'
    if [not path_env] [ = 16 ]
    int status = process.run 'true'
    if [status ne 0] [ = 17 ]
    = 0
]
