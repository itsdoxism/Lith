fn dead_math [int input] int [
    input add 10
    = input
]

fn local_load [] int [
    int value = 9
    = value
]

fn promoted_local [int input] int [
    int value = input
    int other = input add 1
    = value add other
]

fn promoted_branch [int input] int [
    int value = 10
    if [input eq 0] [
        value = 20
    ]
    else [
        value = 30
    ]
    = value
]

fn main [] int [
    int folded = 2 add 3
    if [1 eq 1] [
        = folded
    ]
    else [
        = local_load []
    ]
    io.print 'unreachable'
]
