    if [reversed.left ne 20] [ = 8 ]
    if [make_pair [].right ne 20] [ = 9 ]
    if [global_pair.left ne 9] [ = 10 ]

    int grouped = add_two [1 add 2], [3 mul 4]
    if [grouped ne 15] [ = 11 ]
    int zero = answer []
    if [zero ne 42] [ = 12 ]

    float mixed = 2 add 0.5
    if [mixed ne 2.5] [ = 13 ]
    int narrowed = mixed as int
    if [narrowed ne 2] [ = 14 ]
    float widened = 4
    if [widened ne 4.0] [ = 15 ]
    bool truthy = mixed as bool
    if [not truthy] [ = 16 ]

    ptr int pnull = null
    if [pnull] [ = 17 ]
    str snull = null
    if [snull] [ = 18 ]
    if [global_null] [ = 19 ]
    if [not str.eq global_text, 'lith'] [ = 20 ]

    int choice = match 2 [
        is 1 [ 10 ]
        is 2 [ 20 ]
        else [ 30 ]
    ]
    if [choice ne 20] [ = 21 ]

    str label = match 2 [
        is 1 [ 'one' ]
        is 2 [ 'two' ]
        else [ 'other' ]
    ]
    if [not str.eq label, 'two'] [ = 22 ]

    arr int 2 first = [5, 6]
    arr int 2 second = [7, 8]
    arr int 2 selected = match 1 [
        is 1 [ first ]
