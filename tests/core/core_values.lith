struct Pair [
    int left
    int right
]

struct Node [
    int value
    ptr Node next
]

arr int 3 global_numbers = [7, 8, 9]
arr arr int 2 2 global_matrix = [[1, 2], [3, 4]]
Pair global_pair = Pair [9, 4]
str global_text = 'lith'
ptr int global_null = null

fn sum3 [arr int 3 values] int [
    = values[0] add values[1] add values[2]
]

fn change [arr int 3 values] arr int 3 [
    values[1] = values[1] add 10
    = values
]

fn make_pair [] Pair [
    = Pair [10, 20]
]

fn swap [Pair value] Pair [
    = Pair [value.right, value.left]
]

fn add_two [int a, int b] int [
    = a add b
]

fn answer [] int [
    = 42
]

