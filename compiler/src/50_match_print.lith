fn load_match_target [int unused] str [
    # Complex targets are grouped so the following '[' remains the match body
    # delimiter instead of being mistaken for array indexing.
    if [str.eq g_kind, 'lb'] [
        next_tok 0
        str grouped = parse_expr 0
        str grouped_type = g_expr_type
        str grouped_addr = g_expr_addr
        expect_kind 'rb'
        g_expr_type = grouped_type
        g_expr_addr = grouped_addr
        = grouped
    ]

    if [str.eq g_kind, 'int' or str.eq g_kind, 'float' or str.eq g_kind, 'str'] [
        = parse_primary 0
    ]
    if [str.eq g_kind, 'id' and str.eq g_text, 'true'] [ = parse_primary 0 ]
    if [str.eq g_kind, 'id' and str.eq g_text, 'false'] [ = parse_primary 0 ]
    if [str.eq g_kind, 'id' and str.eq g_text, 'null'] [ = parse_primary 0 ]

    # Preserve the compact `match name [...]` spelling for a simple local or
    # global. More complex expressions use the grouped form above.
    if [str.eq g_kind, 'id'] [
        str name = g_text
        next_tok 0
        str typ = local_type name
        if [str.eq typ, ''] [
            str msg = str.concat 'unknown match target: ', name
            fail_prev msg
            g_expr_type = 'int'
            g_expr_addr = ''
            = '0'
        ]
        str addr = local_addr name
        if [str.starts typ, 'arr '] [
            g_expr_type = typ
            g_expr_addr = addr
            = addr
        ]
        str loaded = ir_load typ, addr
        g_expr_type = typ
        g_expr_addr = addr
        = loaded
    ]
    fail 'unsupported match target'
    g_expr_type = 'int'
    g_expr_addr = ''
    = '0'
]

fn append_print_value [str acc, str value] str [
    str args = ''
    args = ir_args_add args, 0, 'str', acc
    args = ir_args_add args, 1, 'str', value
    = ir_call 'str', 'str.concat', args, 2
]

fn print_value_for_name [str name] str [
    str typ = local_type name
    if [str.eq typ, ''] [
        str msg = str.concat 'unknown io.print interpolation name: ', name
        fail_prev msg
        = ir_string_const ''
    ]
    str addr = local_addr name
    str loaded = ir_load typ, addr

    if [str.eq typ, 'str'] [ = loaded ]
    if [str.eq typ, 'int' or str.eq typ, 'char' or str.eq typ, 'bool'] [
        str iv = intify loaded, typ
        str args = ''
        args = ir_args_add args, 0, 'int', iv
        = ir_call 'str', 'int.str', args, 1
    ]
    fail_prev 'unsupported io.print interpolation type'
    = ir_string_const ''
]

fn emit_print_stmt [int unused] int [
    expect_id 'io'
    expect_kind 'dot'
    expect_id 'print'
    if [not str.eq g_kind, 'str'] [
        = fail 'io.print currently expects a string literal'
    ]

    str text = g_text
    next_tok 0
    str out = ir_string_const ''
    int n = str.len text
    int i = 0
    int segment = 0

    while [i lt n] [
        if [str.at text, i eq 91] [
            if [i gt segment] [
                str literal = str.slice text, segment, i
                out = append_print_value out, ir_string_const literal
            ]
            i = i add 1
            int start = i
            while [i lt n and str.at text, i ne 93] [ i = i add 1 ]
            if [i ge n] [ = fail_prev 'unterminated io.print interpolation' ]
            str name = str.slice text, start, i
            str value = print_value_for_name name
            out = append_print_value out, value
            i = i add 1
            segment = i
        ]
        else [ i = i add 1 ]
    ]

    if [segment lt n] [
        str tail = str.slice text, segment, n
        out = append_print_value out, ir_string_const tail
    ]

    ir_print_line out
    = 0
]
