fn store_typed_value [str addr, str typ, str value] int [
    str st = str.concat 'store ', storage_type typ
    st = str.concat st, ' '
    st = str.concat st, value
    st = str.concat st, ', ptr '
    st = str.concat st, addr
    emit_inst st
    = 0
]

fn emit_struct_literal [str name] str [
    str addr = new_reg 0
    str alloc = str.concat addr, ' = alloca '
    alloc = str.concat alloc, storage_type name
    emit_inst alloc

    expect_kind 'lb'
    int index = 0
    int too_many = 0
    while [not str.eq g_kind, 'rb' and not str.eq g_kind, 'eof'] [
        str field = struct_field_name name, index
        if [str.eq field, ''] [
            # Consume the extra value so diagnostics can recover at the next
            # comma/closing bracket instead of desynchronizing the parser.
            str ignored = parse_expr 0
            if [too_many eq 0] [ fail_prev 'too many values in struct literal' ]
            too_many = 1
        ]
        else [
            str field_type = struct_field_type name, field
            str field_index = struct_field_index name, field
            str field_addr = new_reg 0
            str gep = str.concat field_addr, ' = getelementptr inbounds '
            gep = str.concat gep, storage_type name
            gep = str.concat gep, ', ptr '
            gep = str.concat gep, addr
            gep = str.concat gep, ', i32 0, i32 '
            gep = str.concat gep, field_index
            emit_inst gep

            if [str.starts field_type, 'arr ' and str.eq g_kind, 'lb'] [
                parse_array_literal_into field_addr, field_type
            ]
            else [
                str value = parse_expr 0
                str value_type = g_expr_type
                str value_addr = g_expr_addr
                value = checked_cast value, value_type, field_type
                value = materialize_array_value value, field_type, value_addr
                store_typed_value field_addr, field_type, value
            ]
        ]
        index = index add 1
        if [str.eq g_kind, 'comma'] [ next_tok 0 ]
        else [ break ]
    ]
    expect_kind 'rb'

    str missing = struct_field_name name, index
    if [not str.eq missing, ''] [
        fail_prev 'not enough values in struct literal'
        while [not str.eq missing, ''] [
            str missing_type = struct_field_type name, missing
            str missing_index = struct_field_index name, missing
            str missing_addr = new_reg 0
            str mg = str.concat missing_addr, ' = getelementptr inbounds '
            mg = str.concat mg, storage_type name
            mg = str.concat mg, ', ptr '
            mg = str.concat mg, addr
            mg = str.concat mg, ', i32 0, i32 '
            mg = str.concat mg, missing_index
            emit_inst mg
            store_typed_value missing_addr, missing_type, default_value missing_type
            index = index add 1
            missing = struct_field_name name, index
        ]
    ]

    str loaded = new_reg 0
    str ls = str.concat loaded, ' = load '
    ls = str.concat ls, storage_type name
    ls = str.concat ls, ', ptr '
    ls = str.concat ls, addr
    emit_inst ls
    g_expr_type = name
    g_expr_addr = addr
    = loaded
]

fn emit_match_expr [int unused] str [
    expect_id 'match'
    str target = load_match_target 0
    str target_type = g_expr_type
    expect_kind 'lb'
    skip_nl 0

    str merge_label = new_label 'match.merge'
    str values = ''
    str predecessors = ''
    str result_type = ''
    int result_count = 0

    while [str.eq g_kind, 'id' and str.eq g_text, 'is'] [
        int op_line = g_tok_line
        int op_start = g_tok_start
        int op_end = g_tok_end
        next_tok 0
        str pattern = parse_expr 0
        str pattern_type = g_expr_type
        str case_label = new_label 'match.case'
        str next_label = new_label 'match.next'
        str cond = emit_binary 'eq', target, target_type, pattern, pattern_type, op_line, op_start, op_end
        emit_cbranch cond, case_label, next_label

        emit_label case_label
        expect_kind 'lb'
        skip_nl 0
        str value = parse_expr 0
        str value_type = g_expr_type
        str value_addr = g_expr_addr
        if [str.eq result_type, ''] [ result_type = value_type ]
        else [
            value = checked_cast value, value_type, result_type
            value_type = result_type
        ]
        value = materialize_array_value value, result_type, value_addr
        skip_nl 0
        expect_kind 'rb'
        str predecessor = g_current_label
        emit_branch merge_label
        str key = int.str result_count
        values = map_put values, key, value
        predecessors = map_put predecessors, key, predecessor
        result_count = result_count add 1

        emit_label next_label
        skip_nl 0
    ]

    expect_id 'else'
    expect_kind 'lb'
    skip_nl 0
    str fallback = parse_expr 0
    str fallback_type = g_expr_type
    str fallback_addr = g_expr_addr
    if [str.eq result_type, ''] [ result_type = fallback_type ]
    else [
        fallback = checked_cast fallback, fallback_type, result_type
        fallback_type = result_type
    ]
    fallback = materialize_array_value fallback, result_type, fallback_addr
    skip_nl 0
    expect_kind 'rb'
    str fallback_predecessor = g_current_label
    emit_branch merge_label
    str fallback_key = int.str result_count
    values = map_put values, fallback_key, fallback
    predecessors = map_put predecessors, fallback_key, fallback_predecessor
    result_count = result_count add 1
    skip_nl 0
    expect_kind 'rb'

    emit_label merge_label
    str out = new_reg 0
    str phi = str.concat out, ' = phi '
    phi = str.concat phi, abi_type result_type
    phi = str.concat phi, ' '
    int i = 0
    while [i lt result_count] [
        if [i gt 0] [ phi = str.concat phi, ', ' ]
        str key2 = int.str i
        str pv = map_get values, key2
        str pl = map_get predecessors, key2
        phi = str.concat phi, '[ '
        phi = str.concat phi, pv
        phi = str.concat phi, ', %'
        phi = str.concat phi, pl
        phi = str.concat phi, ' ]'
        i = i add 1
    ]
    emit_inst phi
    g_expr_type = result_type
    g_expr_addr = ''

    if [is_aggregate_type result_type] [
        str result_addr = new_reg 0
        str alloc2 = str.concat result_addr, ' = alloca '
        alloc2 = str.concat alloc2, storage_type result_type
        emit_inst alloc2
        store_typed_value result_addr, result_type, out
        g_expr_addr = result_addr
    ]
    = out
]

