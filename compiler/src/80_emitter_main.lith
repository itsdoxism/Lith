fn emit_struct_ir [int unused] int [
    expect_id 'struct'
    str name = g_text
    next_tok 0
    expect_kind 'lb'
    skip_nl 0
    str fields = ''
    int count = 0
    while [not str.eq g_kind, 'rb' and not str.eq g_kind, 'eof' and g_fatal_error eq 0] [
        str typ = parse_type 0
        next_tok 0
        fields = ir_fields_add fields, count, typ
        count = count add 1
        skip_nl 0
    ]
    if [g_fatal_error eq 0] [ expect_kind 'rb' ]
    ir_struct_decl name, fields, count
    = 0
]

fn emit_global_ir [int unused] int [
    str typ = parse_type 0
    str name = g_text
    next_tok 0
    expect_kind 'assign'
    str value = parse_global_constant typ
    ir_global_decl name, typ, value
    = 0
]

fn emit_function_ir [int unused] int [
    expect_id 'fn'
    str name = g_text
    next_tok 0
    expect_kind 'lb'

    str params = ''
    int param_count = 0
    while [not str.eq g_kind, 'rb' and g_fatal_error eq 0] [
        str typ = parse_type 0
        str pname = g_text
        next_tok 0
        params = ir_params_add params, param_count, typ, pname
        param_count = param_count add 1
        if [str.eq g_kind, 'comma'] [ next_tok 0 ]
        else [ break ]
    ]
    if [g_fatal_error] [ = 0 ]
    expect_kind 'rb'

    str ret = 'int'
    if [str.eq g_kind, 'id'] [ ret = parse_type 0 ]
    g_current_ret = ret
    g_locals = ''
    g_local_addrs = ''
    g_temp = 0
    g_label = 0
    g_terminated = 0
    g_current_label = ''
    g_break_label = ''
    g_continue_label = ''

    ir_begin_function name, ret, params, param_count

    int i = 0
    while [i lt param_count] [
        str ptype = ir_param_type params, i
        str pname2 = ir_param_name params, i
        str paddr = ir_stack_alloc ptype
        str pvalue = ir_param_value pname2
        ir_store ptype, pvalue, paddr
        g_locals = map_put g_locals, pname2, ptype
        g_local_addrs = map_put g_local_addrs, pname2, paddr
        i = i add 1
    ]

    parse_block_ir 0
    if [g_fatal_error] [ = 0 ]
    if [g_terminated eq 0] [
        str fallback = ir_default_value ret
        ir_return ret, fallback
    ]
    ir_end_function 0
    = 0
]

fn compile_source [str source] str [
    g_error = 0
    g_error_count = 0
    g_fatal_error = 0
    g_error_message = ''
    g_out = str.slice '', 0, 0
    g_strings = str.slice '', 0, 0
    g_string_id = 0
    scan_top source
    if [g_fatal_error] [ = '' ]

    ir_module_begin 0
    reset source
    skip_nl 0
    while [not str.eq g_kind, 'eof' and g_fatal_error eq 0] [
        if [str.eq g_kind, 'id' and str.eq g_text, 'use'] [
            next_tok 0
            next_tok 0
        ]
        else [
            if [str.eq g_kind, 'id' and str.eq g_text, 'struct'] [ emit_struct_ir 0 ]
            else [
                if [str.eq g_kind, 'id' and str.eq g_text, 'fn'] [ emit_function_ir 0 ]
                else [
                    if [str.eq g_kind, 'id' and is_type_start g_text] [ emit_global_ir 0 ]
                    else [
                        fatal 'unsupported top level item'
                        = ''
                    ]
                ]
            ]
        ]
        skip_nl 0
    ]
    if [g_fatal_error] [ = '' ]
    if [g_error] [ = '' ]
    = ir_module_finish 0
]

fn main [int argc, ptr str argv] int [
    if [argc lt 3] [ = 2 ]
    str source = load_program argv[1]
    if [g_module_error] [
        io.print 'error: [g_module_error_message]'
        = 1
    ]
    str output = compile_source source
    if [g_error] [
        io.print '[g_error_message]'
        = 1
    ]
    int ok = io.write_text argv[2], output
    if [ok eq 0] [ = 1 ]
    = 0
]
