fn map_put [str table, str key, str value] str [
    str r = str.concat table, key
    str next = str.concat r, '='
    sys.free r
    r = next
    next = str.concat r, value
    sys.free r
    r = next
    str nl = str.chr 10
    next = str.concat r, nl
    sys.free r
    sys.free nl
    = next
]

fn map_key_eq_at [str table, int start, int stop, str key] int [
    int key_len = str.len key
    int len = stop sub start
    if [len ne key_len] [ = 0 ]
    int i = 0
    while [i lt key_len] [
        int pos = start add i
        if [str.at table, pos ne str.at key, i] [ = 0 ]
        i = i add 1
    ]
    = 1
]

fn map_get [str table, str key] str [
    int n = str.len table
    int i = 0
    int found_start = 0
    int found_stop = 0
    int found = 0
    while [i lt n] [
        int ks = i
        while [i lt n and str.at table, i ne 61 and str.at table, i ne 10] [ i = i add 1 ]
        if [i ge n] [ break ]
        if [str.at table, i eq 10] [
            i = i add 1
            continue
        ]
        int key_matches = map_key_eq_at table, ks, i, key
        i = i add 1
        int vs = i
        while [i lt n and str.at table, i ne 10] [ i = i add 1 ]
        if [key_matches] [
            found = 1
            found_start = vs
            found_stop = i
        ]
        if [i lt n] [ i = i add 1 ]
    ]
    if [found] [ = str.slice table, found_start, found_stop ]
    = ''
]

fn fn_param_key [str name, int index] str [
    str r = str.concat name, '@'
    = str.concat r, int.str index
]

fn is_builtin_type_name [str s] int [
    if [str.eq s, 'int'] [ = 1 ]
    if [str.eq s, 'float'] [ = 1 ]
    if [str.eq s, 'str'] [ = 1 ]
    if [str.eq s, 'bool'] [ = 1 ]
    if [str.eq s, 'char'] [ = 1 ]
    if [str.eq s, 'ptr'] [ = 1 ]
    if [str.eq s, 'arr'] [ = 1 ]
    = 0
]

fn is_type_name [str s] int [
    if [is_builtin_type_name s] [ = 1 ]
    if [is_struct_type s] [ = 1 ]
    = 0
]

fn parse_type [int unused] str [
    if [not str.eq g_kind, 'id'] [
        fatal 'expected type name'
        = 'int'
    ]
    str t = g_text
    next_tok 0
    if [str.eq t, 'ptr'] [
        if [not str.eq g_kind, 'id'] [
            fatal 'pointer type expects an element type'
            = 'ptr int'
        ]
        str elem = parse_type 0
        = str.concat 'ptr ', elem
    ]
    if [str.eq t, 'arr'] [
        # Bare `arr name = [...]` keeps local literal inference.
        if [not str.eq g_kind, 'id' or not is_type_name g_text] [ = 'arr' ]
        str elem2 = parse_type 0
        if [not str.eq g_kind, 'int'] [
            fatal 'explicit array type expects a fixed integer length'
            = 'arr 0 int'
        ]
        str count = g_text
        next_tok 0
        str r = str.concat 'arr ', count
        r = str.concat r, ' '
        = str.concat r, elem2
    ]
    if [str.eq t, 'int'] [ = t ]
    if [str.eq t, 'float'] [ = t ]
    if [str.eq t, 'str'] [ = t ]
    if [str.eq t, 'bool'] [ = t ]
    if [str.eq t, 'char'] [ = t ]
    if [is_struct_type t] [ = t ]
    str msg = str.concat 'unknown type: ', t
    fail_prev msg
    = 'int'
]

fn is_decl_type [str s] int [
    = is_builtin_type_name s
]

fn is_type_start [str s] int [
    = is_type_name s
]

fn is_aggregate_type [str t] int [
    if [str.starts t, 'arr '] [ = 1 ]
    if [is_struct_type t] [ = 1 ]
    = 0
]

fn local_type [str name] str [
    str t = map_get g_locals, name
    if [not str.eq t, ''] [ = t ]
    = map_get g_globals, name
]

fn local_addr [str name] str [
    str a = map_get g_local_addrs, name
    if [not str.eq a, ''] [ = a ]
    = ir_global_addr name
]
