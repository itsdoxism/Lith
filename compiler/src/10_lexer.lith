fn append_char [str s, int c] str [
    = str.concat s, str.chr c
]

fn diagnostic_line_start [int pos] int [
    int start = pos
    while [start gt 0] [
        int before = start sub 1
        if [str.at g_src, before eq 10] [ break ]
        start = before
    ]
    = start
]

fn diagnostic_line_end [int pos] int [
    int n = str.len g_src
    int finish = pos
    while [finish lt n and str.at g_src, finish ne 10] [
        finish = finish add 1
    ]
    = finish
]

fn diagnostic_location [int pos, int merged_line] str [
    int scan = diagnostic_line_start pos
    int local_line = 1
    while [scan gt 0] [
        int previous_end = scan sub 1
        int previous_start = diagnostic_line_start previous_end
        str previous_line = str.slice g_src, previous_start, previous_end
        if [str.starts previous_line, '#@module '] [
            int n = str.len previous_line
            str path = str.slice previous_line, 9, n
            str out = 'line '
            out = str.concat out, int.str local_line
            out = str.concat out, ' ('
            out = str.concat out, path
            = str.concat out, ')'
        ]
        local_line = local_line add 1
        scan = previous_start
    ]
    str fallback = 'line '
    = str.concat fallback, int.str merged_line
]

fn make_diagnostic [str msg, int line, int start, int finish] str [
    int line_start = diagnostic_line_start start
    int line_end = diagnostic_line_end start
    str source_line = str.slice g_src, line_start, line_end

    str out = 'error: '
    out = str.concat out, diagnostic_location start, line
    out = str.concat out, ': '
    out = str.concat out, msg
    out = str.concat out, str.chr 10
    out = str.concat out, '    '
    out = str.concat out, source_line
    out = str.concat out, str.chr 10
    out = str.concat out, '    '

    int column = start sub line_start
    int i = 0
    while [i lt column] [
        out = str.concat out, ' '
        i = i add 1
    ]
    out = str.concat out, '^'

    int span = finish sub start
    if [span lt 1] [ span = 1 ]
    int mark = 1
    while [mark lt span] [
        out = str.concat out, '~'
        mark = mark add 1
    ]
    = out
]

fn fail_at [str msg, int line, int start, int finish] int [
    if [g_error_count lt 20] [
        str diagnostic = make_diagnostic msg, line, start, finish
        if [not str.eq g_error_message, ''] [
            g_error_message = str.concat g_error_message, str.chr 10
            g_error_message = str.concat g_error_message, str.chr 10
        ]
        g_error_message = str.concat g_error_message, diagnostic
    ]
    g_error_count = g_error_count add 1
    g_error = 1
    = 0
]

fn fail [str msg] int [
    = fail_at msg, g_tok_line, g_tok_start, g_tok_end
]

fn fail_prev [str msg] int [
    = fail_at msg, g_prev_line, g_prev_start, g_prev_end
]

fn fatal_at [str msg, int line, int start, int finish] int [
    fail_at msg, line, start, finish
    g_fatal_error = 1
    = 0
]

fn fatal [str msg] int [
    = fatal_at msg, g_tok_line, g_tok_start, g_tok_end
]

fn fatal_prev [str msg] int [
    = fatal_at msg, g_prev_line, g_prev_start, g_prev_end
]

fn is_alpha [int c] int [
    = c ge 65 and c le 90 or c ge 97 and c le 122 or c eq 95
]

fn is_digit [int c] int [
    = c ge 48 and c le 57
]

fn next_tok [int unused] int [
    g_prev_start = g_tok_start
    g_prev_end = g_tok_end
    g_prev_line = g_tok_line

    int n = str.len g_src
    while [g_pos lt n] [
        int c = str.at g_src, g_pos
        if [c eq 32 or c eq 9 or c eq 13] [
            g_pos = g_pos add 1
            continue
        ]
        if [c eq 35] [
            while [g_pos lt n and str.at g_src, g_pos ne 10] [
                g_pos = g_pos add 1
            ]
            continue
        ]

        g_tok_start = g_pos
        g_tok_line = g_line

        if [c eq 10] [
            g_pos = g_pos add 1
            g_tok_end = g_pos
            g_kind = 'nl'
            g_text = ''
            g_line = g_line add 1
            = 0
        ]
        if [c eq 39] [
            g_pos = g_pos add 1
            str s = ''
            while [g_pos lt n] [
                int q = str.at g_src, g_pos
                if [q eq 39] [
                    g_pos = g_pos add 1
                    g_tok_end = g_pos
                    g_kind = 'str'
                    g_text = s
                    = 0
                ]
                if [q eq 92] [
                    g_pos = g_pos add 1
                    if [g_pos ge n] [
                        g_tok_end = g_pos
                        = fatal 'unterminated escape'
                    ]
                    int e = str.at g_src, g_pos
                    if [e eq 110] [ s = append_char s, 10 ]
                    else [
                        if [e eq 114] [ s = append_char s, 13 ]
                        else [
                            if [e eq 116] [ s = append_char s, 9 ]
                            else [ s = append_char s, e ]
                        ]
                    ]
                    g_pos = g_pos add 1
                    continue
                ]
                s = append_char s, q
                g_pos = g_pos add 1
            ]
            g_tok_end = g_pos
            = fatal 'unterminated string'
        ]
        if [is_alpha c] [
            int start = g_pos
            g_pos = g_pos add 1
            while [g_pos lt n] [
                int a = str.at g_src, g_pos
                if [not is_alpha a and not is_digit a] [ break ]
                g_pos = g_pos add 1
            ]
            g_tok_end = g_pos
            g_kind = 'id'
            g_text = str.slice g_src, start, g_pos
            = 0
        ]
        if [is_digit c] [
            int startn = g_pos
            g_pos = g_pos add 1
            while [g_pos lt n and is_digit str.at g_src, g_pos] [
                g_pos = g_pos add 1
            ]
            g_kind = 'int'
            if [g_pos lt n and str.at g_src, g_pos eq 46] [
                g_pos = g_pos add 1
                while [g_pos lt n and is_digit str.at g_src, g_pos] [
                    g_pos = g_pos add 1
                ]
                g_kind = 'float'
            ]
            g_tok_end = g_pos
            g_text = str.slice g_src, startn, g_pos
            = 0
        ]
        g_pos = g_pos add 1
        g_tok_end = g_pos
        if [c eq 91] [ g_kind = 'lb' g_text = '[' = 0 ]
        if [c eq 93] [ g_kind = 'rb' g_text = ']' = 0 ]
        if [c eq 44] [ g_kind = 'comma' g_text = ',' = 0 ]
        if [c eq 61] [ g_kind = 'assign' g_text = '=' = 0 ]
        if [c eq 46] [ g_kind = 'dot' g_text = '.' = 0 ]
        = fatal 'unexpected character'
    ]
    g_tok_start = g_pos
    g_tok_end = g_pos
    g_tok_line = g_line
    g_kind = 'eof'
    g_text = ''
    = 0
]

fn reset [str source] int [
    g_src = source
    g_pos = 0
    g_line = 1
    g_kind = 'eof'
    g_text = ''
    g_tok_start = 0
    g_tok_end = 0
    g_tok_line = 1
    g_prev_start = 0
    g_prev_end = 0
    g_prev_line = 1
    = next_tok 0
]

fn skip_nl [int unused] int [
    while [str.eq g_kind, 'nl'] [ next_tok 0 ]
    = 0
]

fn expect_kind [str kind] int [
    if [not str.eq g_kind, kind] [
        fatal 'unexpected token kind'
        next_tok 0
        = 0
    ]
    next_tok 0
    = 1
]

fn expect_id [str text] int [
    if [not str.eq g_kind, 'id'] [
        fatal 'expected identifier'
        next_tok 0
        = 0
    ]
    if [not str.eq g_text, text] [
        fatal 'unexpected identifier'
        next_tok 0
        = 0
    ]
    next_tok 0
    = 1
]

