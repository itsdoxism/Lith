fn parse_expr [int minp] str [
    str left = parse_primary 0
    str lt = g_expr_type
    str la = g_expr_addr
    while [str.eq g_kind, 'id' and precedence g_text ge minp and precedence g_text gt 0] [
        str op = g_text
        int op_line = g_tok_line
        int op_start = g_tok_start
        int op_end = g_tok_end
        int p = precedence op
        next_tok 0
        if [str.eq op, 'as'] [
            str target_type = parse_type 0
            left = explicit_cast left, lt, target_type, op_line, op_start, op_end
            lt = target_type
            la = ''
            continue
        ]
        int nextp = p add 1
        str right = parse_expr nextp
        str rt = g_expr_type
        left = emit_binary op, left, lt, right, rt, op_line, op_start, op_end
        lt = g_expr_type
        la = ''
    ]
    g_expr_type = lt
    g_expr_addr = la
    = left
]

fn emit_call [str name] str [
    str expected = call_argc_text name
    str ret = builtin_ret name
    if [str.eq expected, '' or str.eq ret, ''] [
        str unknown = str.concat 'unknown function: ', name
        fail_prev unknown
        ret = 'int'
    ]

    str args = ''
    int index = 0
    int first = 1

    if [str.eq expected, '0' and str.eq g_kind, 'lb'] [
        next_tok 0
        if [str.eq g_kind, 'rb'] [ next_tok 0 ]
        else [
            fail 'zero-argument call marker must be empty'
            while [not str.eq g_kind, 'rb' and not str.eq g_kind, 'eof'] [ next_tok 0 ]
            if [str.eq g_kind, 'rb'] [ next_tok 0 ]
        ]
    ]
    else [
        while [starts_expr 0] [
            str a = parse_expr 6
            str at = g_expr_type
            str aa = g_expr_addr
            str pt = builtin_param name, index
            if [not str.eq pt, ''] [
                a = checked_cast a, at, pt
                at = pt
            ]
            a = materialize_array_value a, at, aa
            if [first eq 0] [ args = str.concat args, ', ' ]
            args = str.concat args, abi_type at
            args = str.concat args, ' '
            args = str.concat args, a
            first = 0
            index = index add 1
            if [str.eq g_kind, 'comma'] [ next_tok 0 ]
            else [ break ]
        ]
    ]

    if [not str.eq expected, '' and not str.eq expected, int.str index] [
        str msg = 'argument count mismatch: expected '
        msg = str.concat msg, expected
        msg = str.concat msg, ', got '
        msg = str.concat msg, int.str index
        fail_prev msg
    ]

    str mapped = mapped_name name
    str r = new_reg 0
    str s = str.concat r, ' = call '
    s = str.concat s, abi_type ret
    s = str.concat s, ' @'
    s = str.concat s, mapped
    s = str.concat s, '('
    s = str.concat s, args
    s = str.concat s, ')'
    emit_inst s
    g_expr_type = ret
    g_expr_addr = ''

    if [is_aggregate_type ret] [
        str addr = new_reg 0
        str alloc = str.concat addr, ' = alloca '
        alloc = str.concat alloc, storage_type ret
        emit_inst alloc
        store_typed_value addr, ret, r
        g_expr_addr = addr
    ]
    = r
]

fn parse_postfix_value [str initial_value, str initial_type, str initial_addr] str [
    str value = initial_value
    str current_type = initial_type
    str current_addr = initial_addr

    while [str.eq g_kind, 'lb'] [
        next_tok 0
        str idx = parse_expr 0
        str it = g_expr_type
        if [not str.eq it, 'int' and not str.eq it, 'char'] [
            str imsg = str.concat 'array or pointer index must be int, got ', it
            fail_prev imsg
            idx = '0'
        ]
        else [ idx = intify idx, it ]
        expect_kind 'rb'
        str elem = ''
        str gep = new_reg 0
        str gs = ''
        if [str.starts current_type, 'ptr '] [
            elem = str.slice current_type, 4, str.len current_type
            gs = str.concat gep, ' = getelementptr inbounds '
            gs = str.concat gs, storage_type elem
            gs = str.concat gs, ', ptr '
            gs = str.concat gs, value
            gs = str.concat gs, ', i32 '
            gs = str.concat gs, idx
        ]
        else [
            if [str.starts current_type, 'arr '] [
                elem = array_elem_type current_type
                if [str.eq current_addr, ''] [
                    fail_prev 'array indexing requires an addressable array value'
                    = value
                ]
                gs = str.concat gep, ' = getelementptr inbounds '
                gs = str.concat gs, storage_type current_type
                gs = str.concat gs, ', ptr '
                gs = str.concat gs, current_addr
                gs = str.concat gs, ', i32 0, i32 '
                gs = str.concat gs, idx
            ]
            else [
                fail_prev 'indexing requires an array or pointer'
                = value
            ]
        ]
        emit_inst gs
        str loaded = new_reg 0
        str ls = str.concat loaded, ' = load '
        ls = str.concat ls, storage_type elem
        ls = str.concat ls, ', ptr '
        ls = str.concat ls, gep
        emit_inst ls
        value = loaded
        current_type = elem
        current_addr = gep
    ]

    while [str.eq g_kind, 'dot'] [
        next_tok 0
        if [not str.eq g_kind, 'id'] [
            fatal 'expected struct field'
            = value
        ]
        str field = g_text
        next_tok 0
        if [not is_struct_type current_type] [
            fail_prev 'member access requires a struct value'
            = value
        ]
        if [str.eq current_addr, ''] [
            fail_prev 'member access requires an addressable struct value'
            = value
        ]
        str field_index = struct_field_index current_type, field
        str field_type = struct_field_type current_type, field
        if [str.eq field_index, '' or str.eq field_type, ''] [
            str fmsg = str.concat 'unknown struct field: ', field
            fail_prev fmsg
            = value
        ]
        str field_addr = new_reg 0
        str fs = str.concat field_addr, ' = getelementptr inbounds '
        fs = str.concat fs, storage_type current_type
        fs = str.concat fs, ', ptr '
        fs = str.concat fs, current_addr
        fs = str.concat fs, ', i32 0, i32 '
        fs = str.concat fs, field_index
        emit_inst fs
        str field_value = new_reg 0
        str fl = str.concat field_value, ' = load '
        fl = str.concat fl, storage_type field_type
        fl = str.concat fl, ', ptr '
        fl = str.concat fl, field_addr
        emit_inst fl
        value = field_value
        current_type = field_type
        current_addr = field_addr
    ]

    g_expr_type = current_type
    g_expr_addr = current_addr
    = value
]

fn parse_primary [int unused] str [
    if [str.eq g_kind, 'int'] [
        str v = g_text
        next_tok 0
        g_expr_type = 'int'
        g_expr_addr = ''
        = v
    ]
    if [str.eq g_kind, 'float'] [
        str v2 = g_text
        next_tok 0
        g_expr_type = 'float'
        g_expr_addr = ''
        = v2
    ]
    if [str.eq g_kind, 'str'] [
        str v3 = string_const g_text
        next_tok 0
        g_expr_type = 'str'
        g_expr_addr = ''
        = v3
    ]
    if [str.eq g_kind, 'lb'] [
        next_tok 0
        if [str.eq g_kind, 'rb'] [
            fatal 'empty brackets are only valid as a zero-argument call marker'
            next_tok 0
            g_expr_type = 'int'
            g_expr_addr = ''
            = '0'
        ]
        str grouped = parse_expr 0
        str grouped_type = g_expr_type
        str grouped_addr = g_expr_addr
        expect_kind 'rb'
        g_expr_type = grouped_type
        g_expr_addr = grouped_addr
        = grouped
    ]
    if [str.eq g_kind, 'id' and str.eq g_text, 'true'] [
        next_tok 0
        g_expr_type = 'bool'
        g_expr_addr = ''
        = '1'
    ]
    if [str.eq g_kind, 'id' and str.eq g_text, 'false'] [
        next_tok 0
        g_expr_type = 'bool'
        g_expr_addr = ''
        = '0'
    ]
    if [str.eq g_kind, 'id' and str.eq g_text, 'null'] [
        next_tok 0
        g_expr_type = 'ptr any'
        g_expr_addr = ''
        = 'null'
    ]
    if [str.eq g_kind, 'id' and str.eq g_text, 'match'] [
        = emit_match_expr 0
    ]
    if [str.eq g_kind, 'id' and str.eq g_text, 'not'] [
        next_tok 0
        str x = parse_primary 0
        str xt = g_expr_type
        str b = boolify x, xt
        str rnot = new_reg 0
        str sn = str.concat rnot, ' = xor i1 '
        sn = str.concat sn, b
        sn = str.concat sn, ', true'
        emit_inst sn
        g_expr_type = 'bool'
        g_expr_addr = ''
        = rnot
    ]
    if [str.eq g_kind, 'id'] [
        str root = g_text
        next_tok 0
        str root_type = local_type root

        if [not str.eq root_type, ''] [
            str addr = local_addr root
            str value = addr
            if [not str.starts root_type, 'arr '] [
                str loaded = new_reg 0
                str load = str.concat loaded, ' = load '
                load = str.concat load, storage_type root_type
                load = str.concat load, ', ptr '
                load = str.concat load, addr
                emit_inst load
                value = loaded
            ]
            = parse_postfix_value value, root_type, addr
        ]

        if [is_struct_type root and str.eq g_kind, 'lb'] [
            str literal = emit_struct_literal root
            str literal_type = g_expr_type
            str literal_addr = g_expr_addr
            = parse_postfix_value literal, literal_type, literal_addr
        ]

        str name = root
        while [str.eq g_kind, 'dot'] [
            next_tok 0
            if [not str.eq g_kind, 'id'] [
                fatal 'expected name after dot'
                = '0'
            ]
            name = str.concat name, '.'
            name = str.concat name, g_text
            next_tok 0
        ]

        str expected = call_argc_text name
        str ret = builtin_ret name
        if [not str.eq expected, '' and not str.eq ret, ''] [
            str called = emit_call name
            str called_type = g_expr_type
            str called_addr = g_expr_addr
            = parse_postfix_value called, called_type, called_addr
        ]

        str unknown = str.concat 'unknown variable or function: ', name
        fail_prev unknown
        g_expr_type = 'int'
        g_expr_addr = ''
        = '0'
    ]
    fatal 'expected expression'
    g_expr_type = 'int'
    g_expr_addr = ''
    = '0'
]

