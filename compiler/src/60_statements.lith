fn looks_like_unknown_typed_decl [int unused] int [
    if [not str.eq g_kind, 'id'] [ = 0 ]
    if [is_type_start g_text] [ = 0 ]

    int save_pos = g_pos
    int save_line = g_line
    str save_source_file = g_source_file
    str save_kind = g_kind
    str save_text = g_text
    int save_tok_start = g_tok_start
    int save_tok_end = g_tok_end
    int save_tok_line = g_tok_line
    str save_tok_file = g_tok_file
    int save_prev_start = g_prev_start
    int save_prev_end = g_prev_end
    int save_prev_line = g_prev_line
    str save_prev_file = g_prev_file
    int save_fatal = g_fatal_error

    next_tok 0
    int looks = 0
    if [str.eq g_kind, 'id'] [
        next_tok 0
        if [str.eq g_kind, 'assign'] [ looks = 1 ]
    ]

    g_pos = save_pos
    g_line = save_line
    g_source_file = save_source_file
    g_kind = save_kind
    g_text = save_text
    g_tok_start = save_tok_start
    g_tok_end = save_tok_end
    g_tok_line = save_tok_line
    g_tok_file = save_tok_file
    g_prev_start = save_prev_start
    g_prev_end = save_prev_end
    g_prev_line = save_prev_line
    g_prev_file = save_prev_file
    g_fatal_error = save_fatal
    = looks
]

fn parse_stmt_ir [int unused] int [
    skip_nl 0
    if [str.eq g_kind, 'id' and str.eq g_text, 'if'] [
        next_tok 0
        expect_kind 'lb'
        str cond = parse_expr 0
        str ct = g_expr_type
        cond = boolify cond, ct
        expect_kind 'rb'
        str yes = new_label 'if.then'
        str no = new_label 'if.else'
        str done = new_label 'if.end'
        emit_cbranch cond, yes, no
        emit_label yes
        parse_block_ir 0
        int yes_term = g_terminated
        if [yes_term eq 0] [ emit_branch done ]
        skip_nl 0
        if [str.eq g_kind, 'id' and str.eq g_text, 'else'] [
            next_tok 0
            emit_label no
            parse_block_ir 0
            int no_term = g_terminated
            if [no_term eq 0] [ emit_branch done ]
            emit_label done
            if [yes_term and no_term] [ emit_unreachable 0 ]
        ]
        else [
            emit_label no
            emit_branch done
            emit_label done
        ]
        = 0
    ]
    if [str.eq g_kind, 'id' and str.eq g_text, 'while'] [
        next_tok 0
        str cond_label = new_label 'while.cond'
        str body_label = new_label 'while.body'
        str end_label = new_label 'while.end'
        emit_branch cond_label
        emit_label cond_label
        expect_kind 'lb'
        str condw = parse_expr 0
        str cwt = g_expr_type
        condw = boolify condw, cwt
        expect_kind 'rb'
        emit_cbranch condw, body_label, end_label
        emit_label body_label
        str old_break = g_break_label
        str old_continue = g_continue_label
        g_break_label = end_label
        g_continue_label = cond_label
        parse_block_ir 0
        g_break_label = old_break
        g_continue_label = old_continue
        if [g_terminated eq 0] [ emit_branch cond_label ]
        emit_label end_label
        = 0
    ]
    if [str.eq g_kind, 'id' and str.eq g_text, 'loop'] [
        next_tok 0
        if [not str.eq g_kind, 'id'] [ = fail 'loop expects item name' ]
        str item = g_text
        str existing_item = map_get g_locals, item
        if [not str.eq existing_item, ''] [
            str dmsg = str.concat 'duplicate local: ', item
            fail dmsg
        ]
        next_tok 0
        expect_id 'in'
        if [not str.eq g_kind, 'id'] [ = fail 'loop expects array name' ]
        str collection = g_text
        next_tok 0
        str collection_type = local_type collection
        if [str.eq collection_type, ''] [
            str umsg = str.concat 'unknown variable: ', collection
            fail_prev umsg
        ]
        if [not str.starts collection_type, 'arr '] [ = fail_prev 'loop currently requires an array' ]
        str elem_type = array_elem_type collection_type
        str count = array_count_text collection_type
        str collection_addr = local_addr collection

        str index_addr = new_reg 0
        str ia = str.concat index_addr, ' = alloca i32'
        emit_inst ia
        str init = str.concat 'store i32 0, ptr ', index_addr
        emit_inst init

        str cond_label = new_label 'loop.cond'
        str body_label = new_label 'loop.body'
        str step_label = new_label 'loop.step'
        str end_label = new_label 'loop.end'
        emit_branch cond_label
        emit_label cond_label
        str index_value = new_reg 0
        str il = str.concat index_value, ' = load i32, ptr '
        il = str.concat il, index_addr
        emit_inst il
        str cond = new_reg 0
        str cs = str.concat cond, ' = icmp slt i32 '
        cs = str.concat cs, index_value
        cs = str.concat cs, ', '
        cs = str.concat cs, count
        emit_inst cs
        emit_cbranch cond, body_label, end_label

        emit_label body_label
        str elem_addr = new_reg 0
        str eg = str.concat elem_addr, ' = getelementptr inbounds '
        eg = str.concat eg, storage_type collection_type
        eg = str.concat eg, ', ptr '
        eg = str.concat eg, collection_addr
        eg = str.concat eg, ', i32 0, i32 '
        eg = str.concat eg, index_value
        emit_inst eg
        str elem_value = new_reg 0
        str el = str.concat elem_value, ' = load '
        el = str.concat el, storage_type elem_type
        el = str.concat el, ', ptr '
        el = str.concat el, elem_addr
        emit_inst el

        str old_locals = g_locals
        str old_addrs = g_local_addrs
        str item_addr = new_reg 0
        str item_alloc = str.concat item_addr, ' = alloca '
        item_alloc = str.concat item_alloc, storage_type elem_type
        emit_inst item_alloc
        str item_store = str.concat 'store ', storage_type elem_type
        item_store = str.concat item_store, ' '
        item_store = str.concat item_store, elem_value
        item_store = str.concat item_store, ', ptr '
        item_store = str.concat item_store, item_addr
        emit_inst item_store
        g_locals = map_put g_locals, item, elem_type
        g_local_addrs = map_put g_local_addrs, item, item_addr

        str old_break = g_break_label
        str old_continue = g_continue_label
        g_break_label = end_label
        g_continue_label = step_label
        parse_block_ir 0
        g_break_label = old_break
        g_continue_label = old_continue
        g_locals = old_locals
        g_local_addrs = old_addrs
        if [g_terminated eq 0] [ emit_branch step_label ]

        emit_label step_label
        str step_old = new_reg 0
        str sl = str.concat step_old, ' = load i32, ptr '
        sl = str.concat sl, index_addr
        emit_inst sl
        str step_new = new_reg 0
        str sa = str.concat step_new, ' = add i32 '
        sa = str.concat sa, step_old
        sa = str.concat sa, ', 1'
        emit_inst sa
        str ss = str.concat 'store i32 ', step_new
        ss = str.concat ss, ', ptr '
        ss = str.concat ss, index_addr
        emit_inst ss
        emit_branch cond_label
        emit_label end_label
        = 0
    ]
    if [str.eq g_kind, 'id' and str.eq g_text, 'break'] [
        if [str.eq g_break_label, ''] [
            fail 'break used outside a loop'
            next_tok 0
            = 0
        ]
        next_tok 0
        emit_branch g_break_label
        = 0
    ]
    if [str.eq g_kind, 'id' and str.eq g_text, 'continue'] [
        if [str.eq g_continue_label, ''] [
            fail 'continue used outside a loop'
            next_tok 0
            = 0
        ]
        next_tok 0
        emit_branch g_continue_label
        = 0
    ]
    if [str.eq g_kind, 'assign'] [
        next_tok 0
        str rv = parse_expr 0
        str rt = g_expr_type
        str ra = g_expr_addr
        rv = checked_cast rv, rt, g_current_ret
        rv = materialize_array_value rv, g_current_ret, ra
        emit_return g_current_ret, rv
        = 0
    ]
    if [str.eq g_kind, 'id' and str.eq g_text, 'return'] [
        next_tok 0
        str rv2 = parse_expr 0
        str rt2 = g_expr_type
        str ra2 = g_expr_addr
        rv2 = checked_cast rv2, rt2, g_current_ret
        rv2 = materialize_array_value rv2, g_current_ret, ra2
        emit_return g_current_ret, rv2
        = 0
    ]
    if [str.eq g_kind, 'id'] [
        int declaration = 0
        if [is_type_start g_text] [ declaration = 1 ]
        else [
            if [looks_like_unknown_typed_decl 0] [ declaration = 1 ]
        ]
        if [declaration] [ = parse_decl_ir 0 ]
    ]
    if [str.eq g_kind, 'id' and str.eq g_text, 'io'] [
        = emit_print_stmt 0
    ]
    if [str.eq g_kind, 'id' and str.eq g_text, 'sys'] [
        str ignored = emit_sys_memory 'ptr int'
        = 0
    ]
    str lhs = parse_expr 0
    str lhs_type = g_expr_type
    str lhs_addr = g_expr_addr
    if [str.eq g_kind, 'assign'] [
        int writable = 1
        if [str.eq lhs_addr, ''] [
            fail 'assignment target is not writable'
            writable = 0
        ]
        next_tok 0
        str rhs = ''
        if [str.eq g_kind, 'id' and str.eq g_text, 'sys'] [
            rhs = emit_sys_memory lhs_type
        ]
        else [
            rhs = parse_expr 0
        ]
        str rhs_type = g_expr_type
        str rhs_addr = g_expr_addr
        rhs = checked_cast rhs, rhs_type, lhs_type
        rhs = materialize_array_value rhs, lhs_type, rhs_addr
        if [writable eq 0] [ = 0 ]
        str st = str.concat 'store ', storage_type lhs_type
        st = str.concat st, ' '
        st = str.concat st, rhs
        st = str.concat st, ', ptr '
        st = str.concat st, lhs_addr
        emit_inst st
        = 0
    ]
    = 0
]
