fn looks_like_unknown_typed_decl [int unused] int [
    if [not str.eq g_kind, 'id'] [ = 0 ]
    if [is_type_start g_text] [ = 0 ]

    int save_pos = g_pos
    int save_line = g_line
    str save_source_file = g_source_file
    str save_kind = g_kind
    str save_text = g_text
    int save_tok_start = g_tok_start
    int save_tok_end = g_tok_end
    int save_tok_line = g_tok_line
    str save_tok_file = g_tok_file
    int save_prev_start = g_prev_start
    int save_prev_end = g_prev_end
    int save_prev_line = g_prev_line
    str save_prev_file = g_prev_file
    int save_fatal = g_fatal_error

    next_tok 0
    int looks = 0
    if [str.eq g_kind, 'id'] [
        next_tok 0
        if [str.eq g_kind, 'assign'] [ looks = 1 ]
    ]

    g_pos = save_pos
    g_line = save_line
    g_source_file = save_source_file
    g_kind = save_kind
    g_text = save_text
    g_tok_start = save_tok_start
    g_tok_end = save_tok_end
    g_tok_line = save_tok_line
    g_tok_file = save_tok_file
    g_prev_start = save_prev_start
    g_prev_end = save_prev_end
    g_prev_line = save_prev_line
    g_prev_file = save_prev_file
    g_fatal_error = save_fatal
    = looks
]

fn parse_stmt_ir [int unused] int [
    skip_nl 0
    if [str.eq g_kind, 'id' and str.eq g_text, 'if'] [
        next_tok 0
        expect_kind 'lb'
        str cond = parse_expr 0
        str ct = g_expr_type
        cond = boolify cond, ct
        expect_kind 'rb'
        str yes = ir_new_label 'if.then'
        str no = ir_new_label 'if.else'
        str done = ir_new_label 'if.end'
        ir_cbranch cond, yes, no
        ir_label yes
        parse_block_ir 0
        int yes_term = g_terminated
        if [yes_term eq 0] [ ir_branch done ]
        skip_nl 0
        if [str.eq g_kind, 'id' and str.eq g_text, 'else'] [
            next_tok 0
            ir_label no
            parse_block_ir 0
            int no_term = g_terminated
            if [no_term eq 0] [ ir_branch done ]
            ir_label done
            if [yes_term and no_term] [ ir_unreachable 0 ]
        ]
        else [
            ir_label no
            ir_branch done
            ir_label done
        ]
        = 0
    ]
    if [str.eq g_kind, 'id' and str.eq g_text, 'while'] [
        next_tok 0
        str cond_label = ir_new_label 'while.cond'
        str body_label = ir_new_label 'while.body'
        str end_label = ir_new_label 'while.end'
        ir_branch cond_label
        ir_label cond_label
        expect_kind 'lb'
        str condw = parse_expr 0
        str cwt = g_expr_type
        condw = boolify condw, cwt
        expect_kind 'rb'
        ir_cbranch condw, body_label, end_label
        ir_label body_label
        str old_break = g_break_label
        str old_continue = g_continue_label
        g_break_label = end_label
        g_continue_label = cond_label
        parse_block_ir 0
        g_break_label = old_break
        g_continue_label = old_continue
        if [g_terminated eq 0] [ ir_branch cond_label ]
        ir_label end_label
        = 0
    ]
    if [str.eq g_kind, 'id' and str.eq g_text, 'loop'] [
        next_tok 0
        if [not str.eq g_kind, 'id'] [ = fail 'loop expects item name' ]
        str item = g_text
        str existing_item = map_get g_locals, item
        if [not str.eq existing_item, ''] [
            str dmsg = str.concat 'duplicate local: ', item
            fail dmsg
        ]
        next_tok 0
        expect_id 'in'
        if [not str.eq g_kind, 'id'] [ = fail 'loop expects array name' ]
        str collection = g_text
        next_tok 0
        str collection_type = local_type collection
        if [str.eq collection_type, ''] [
            str umsg = str.concat 'unknown variable: ', collection
            fail_prev umsg
        ]
        if [not str.starts collection_type, 'arr '] [ = fail_prev 'loop currently requires an array' ]
        str elem_type = array_elem_type collection_type
        str count = array_count_text collection_type
        str collection_addr = local_addr collection

        str index_addr = ir_stack_alloc 'int'
        ir_store 'int', '0', index_addr

        str cond_label = ir_new_label 'loop.cond'
        str body_label = ir_new_label 'loop.body'
        str step_label = ir_new_label 'loop.step'
        str end_label = ir_new_label 'loop.end'
        ir_branch cond_label
        ir_label cond_label
        str index_value = ir_load 'int', index_addr
        str cond = ir_compare_int 'lt', index_value, count
        ir_cbranch cond, body_label, end_label

        ir_label body_label
        str elem_addr = ir_array_addr collection_type, collection_addr, index_value
        str elem_value = ir_load elem_type, elem_addr

        str old_locals = g_locals
        str old_addrs = g_local_addrs
        str item_addr = ir_stack_alloc elem_type
        ir_store elem_type, elem_value, item_addr
        g_locals = map_put g_locals, item, elem_type
        g_local_addrs = map_put g_local_addrs, item, item_addr

        str old_break = g_break_label
        str old_continue = g_continue_label
        g_break_label = end_label
        g_continue_label = step_label
        parse_block_ir 0
        g_break_label = old_break
        g_continue_label = old_continue
        g_locals = old_locals
        g_local_addrs = old_addrs
        if [g_terminated eq 0] [ ir_branch step_label ]

        ir_label step_label
        str step_old = ir_load 'int', index_addr
        str step_new = ir_arith_int 'add', step_old, '1'
        ir_store 'int', step_new, index_addr
        ir_branch cond_label
        ir_label end_label
        = 0
    ]
    if [str.eq g_kind, 'id' and str.eq g_text, 'break'] [
        if [str.eq g_break_label, ''] [
            fail 'break used outside a loop'
            next_tok 0
            = 0
        ]
        next_tok 0
        ir_branch g_break_label
        = 0
    ]
    if [str.eq g_kind, 'id' and str.eq g_text, 'continue'] [
        if [str.eq g_continue_label, ''] [
            fail 'continue used outside a loop'
            next_tok 0
            = 0
        ]
        next_tok 0
        ir_branch g_continue_label
        = 0
    ]
    if [str.eq g_kind, 'assign'] [
        next_tok 0
        str rv = parse_expr 0
        str rt = g_expr_type
        str ra = g_expr_addr
        rv = checked_cast rv, rt, g_current_ret
        rv = materialize_array_value rv, g_current_ret, ra
        ir_return g_current_ret, rv
        = 0
    ]
    if [str.eq g_kind, 'id' and str.eq g_text, 'return'] [
        next_tok 0
        str rv2 = parse_expr 0
        str rt2 = g_expr_type
        str ra2 = g_expr_addr
        rv2 = checked_cast rv2, rt2, g_current_ret
        rv2 = materialize_array_value rv2, g_current_ret, ra2
        ir_return g_current_ret, rv2
        = 0
    ]
    if [str.eq g_kind, 'id'] [
        int declaration = 0
        if [is_type_start g_text] [ declaration = 1 ]
        else [
            if [looks_like_unknown_typed_decl 0] [ declaration = 1 ]
        ]
        if [declaration] [ = parse_decl_ir 0 ]
    ]
    if [str.eq g_kind, 'id' and str.eq g_text, 'io'] [
        = emit_print_stmt 0
    ]
    if [str.eq g_kind, 'id' and str.eq g_text, 'sys'] [
        str ignored = emit_sys_memory 'ptr int'
        = 0
    ]
    str lhs = parse_expr 0
    str lhs_type = g_expr_type
    str lhs_addr = g_expr_addr
    if [str.eq g_kind, 'assign'] [
        int writable = 1
        if [str.eq lhs_addr, ''] [
            fail 'assignment target is not writable'
            writable = 0
        ]
        next_tok 0
        str rhs = ''
        if [str.eq g_kind, 'id' and str.eq g_text, 'sys'] [
            rhs = emit_sys_memory lhs_type
        ]
        else [
            rhs = parse_expr 0
        ]
        str rhs_type = g_expr_type
        str rhs_addr = g_expr_addr
        rhs = checked_cast rhs, rhs_type, lhs_type
        rhs = materialize_array_value rhs, lhs_type, rhs_addr
        if [writable eq 0] [ = 0 ]
        ir_store lhs_type, rhs, lhs_addr
        = 0
    ]
    = 0
]
