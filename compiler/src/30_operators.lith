fn precedence [str op] int [
    if [str.eq op, 'or'] [ = 1 ]
    if [str.eq op, 'and'] [ = 2 ]
    if [str.eq op, 'eq'] [ = 3 ]
    if [str.eq op, 'ne'] [ = 3 ]
    if [str.eq op, 'gt'] [ = 3 ]
    if [str.eq op, 'lt'] [ = 3 ]
    if [str.eq op, 'ge'] [ = 3 ]
    if [str.eq op, 'le'] [ = 3 ]
    if [str.eq op, 'add'] [ = 4 ]
    if [str.eq op, 'sub'] [ = 4 ]
    if [str.eq op, 'mul'] [ = 5 ]
    if [str.eq op, 'div'] [ = 5 ]
    if [str.eq op, 'mod'] [ = 5 ]
    if [str.eq op, 'as'] [ = 6 ]
    = 0
]

fn starts_expr [int unused] int [
    if [str.eq g_kind, 'int'] [ = 1 ]
    if [str.eq g_kind, 'float'] [ = 1 ]
    if [str.eq g_kind, 'str'] [ = 1 ]
    if [str.eq g_kind, 'lb'] [ = 1 ]
    if [str.eq g_kind, 'id'] [ = 1 ]
    = 0
]

fn builtin_ret [str name] str [
    if [str.eq name, 'io.read_text'] [ = 'str' ]
    if [str.eq name, 'io.write_text'] [ = 'int' ]
    if [str.eq name, 'fs.read_text'] [ = 'str' ]
    if [str.eq name, 'fs.write_text'] [ = 'int' ]
    if [str.eq name, 'fs.read_bytes'] [ = 'bytes' ]
    if [str.eq name, 'fs.write_bytes'] [ = 'int' ]
    if [str.eq name, 'fs.exists'] [ = 'int' ]
    if [str.eq name, 'fs.remove'] [ = 'int' ]
    if [str.eq name, 'fs.rename'] [ = 'int' ]
    if [str.eq name, 'fs.mkdir'] [ = 'int' ]
    if [str.eq name, 'fs.rmdir'] [ = 'int' ]
    if [str.eq name, 'fs.chdir'] [ = 'int' ]
    if [str.eq name, 'fs.cwd'] [ = 'str' ]
    if [str.eq name, 'fs.list'] [ = 'str' ]
    if [str.eq name, 'path.join'] [ = 'str' ]
    if [str.eq name, 'path.dirname'] [ = 'str' ]
    if [str.eq name, 'path.basename'] [ = 'str' ]
    if [str.eq name, 'path.ext'] [ = 'str' ]
    if [str.eq name, 'path.normalize'] [ = 'str' ]
    if [str.eq name, 'process.run'] [ = 'int' ]
    if [str.eq name, 'process.env'] [ = 'str' ]
    if [str.eq name, 'str.len'] [ = 'int' ]
    if [str.eq name, 'str.at'] [ = 'int' ]
    if [str.eq name, 'str.slice'] [ = 'str' ]
    if [str.eq name, 'str.concat'] [ = 'str' ]
    if [str.eq name, 'str.eq'] [ = 'int' ]
    if [str.eq name, 'str.starts'] [ = 'int' ]
    if [str.eq name, 'str.trim'] [ = 'str' ]
    if [str.eq name, 'str.chr'] [ = 'str' ]
    if [str.eq name, 'bytes.from_str'] [ = 'bytes' ]
    if [str.eq name, 'bytes.to_str'] [ = 'str' ]
    if [str.eq name, 'bytes.alloc'] [ = 'bytes' ]
    if [str.eq name, 'bytes.len'] [ = 'int' ]
    if [str.eq name, 'bytes.at'] [ = 'int' ]
    if [str.eq name, 'bytes.set'] [ = 'int' ]
    if [str.eq name, 'bytes.slice'] [ = 'bytes' ]
    if [str.eq name, 'bytes.concat'] [ = 'bytes' ]
    if [str.eq name, 'bytes.eq'] [ = 'int' ]
    if [str.eq name, 'bytes.ptr'] [ = 'ptr char' ]
    if [str.eq name, 'bytes.free'] [ = 'int' ]
    if [str.eq name, 'int.str'] [ = 'str' ]
    = map_get g_fn_ret, name
]

fn builtin_argc [str name] int [
    if [str.eq name, 'io.read_text'] [ = 1 ]
    if [str.eq name, 'io.write_text'] [ = 2 ]
    if [str.eq name, 'fs.read_text'] [ = 1 ]
    if [str.eq name, 'fs.write_text'] [ = 2 ]
    if [str.eq name, 'fs.read_bytes'] [ = 1 ]
    if [str.eq name, 'fs.write_bytes'] [ = 2 ]
    if [str.eq name, 'fs.exists'] [ = 1 ]
    if [str.eq name, 'fs.remove'] [ = 1 ]
    if [str.eq name, 'fs.rename'] [ = 2 ]
    if [str.eq name, 'fs.mkdir'] [ = 1 ]
    if [str.eq name, 'fs.rmdir'] [ = 1 ]
    if [str.eq name, 'fs.chdir'] [ = 1 ]
    if [str.eq name, 'fs.cwd'] [ = 0 ]
    if [str.eq name, 'fs.list'] [ = 1 ]
    if [str.eq name, 'path.join'] [ = 2 ]
    if [str.eq name, 'path.dirname'] [ = 1 ]
    if [str.eq name, 'path.basename'] [ = 1 ]
    if [str.eq name, 'path.ext'] [ = 1 ]
    if [str.eq name, 'path.normalize'] [ = 1 ]
    if [str.eq name, 'process.run'] [ = 1 ]
    if [str.eq name, 'process.env'] [ = 1 ]
    if [str.eq name, 'str.len'] [ = 1 ]
    if [str.eq name, 'str.at'] [ = 2 ]
    if [str.eq name, 'str.slice'] [ = 3 ]
    if [str.eq name, 'str.concat'] [ = 2 ]
    if [str.eq name, 'str.eq'] [ = 2 ]
    if [str.eq name, 'str.starts'] [ = 2 ]
    if [str.eq name, 'str.trim'] [ = 1 ]
    if [str.eq name, 'str.chr'] [ = 1 ]
    if [str.eq name, 'bytes.from_str'] [ = 1 ]
    if [str.eq name, 'bytes.to_str'] [ = 1 ]
    if [str.eq name, 'bytes.alloc'] [ = 1 ]
    if [str.eq name, 'bytes.len'] [ = 1 ]
    if [str.eq name, 'bytes.at'] [ = 2 ]
    if [str.eq name, 'bytes.set'] [ = 3 ]
    if [str.eq name, 'bytes.slice'] [ = 3 ]
    if [str.eq name, 'bytes.concat'] [ = 2 ]
    if [str.eq name, 'bytes.eq'] [ = 2 ]
    if [str.eq name, 'bytes.ptr'] [ = 1 ]
    if [str.eq name, 'bytes.free'] [ = 1 ]
    if [str.eq name, 'int.str'] [ = 1 ]
    str n = map_get g_fn_argc, name
    if [str.eq n, ''] [ = 0 ]
    = 0
]

fn call_argc_text [str name] str [
    if [str.eq name, 'fs.cwd'] [ = '0' ]
    int builtin = builtin_argc name
    if [builtin gt 0] [ = int.str builtin ]
    = map_get g_fn_argc, name
]

fn builtin_param [str name, int index] str [
    if [str.eq name, 'io.read_text'] [ = 'str' ]
    if [str.eq name, 'io.write_text'] [ = 'str' ]
    if [str.eq name, 'fs.read_text'] [ = 'str' ]
    if [str.eq name, 'fs.write_text'] [ = 'str' ]
    if [str.eq name, 'fs.read_bytes'] [ = 'str' ]
    if [str.eq name, 'fs.write_bytes'] [
        if [index eq 0] [ = 'str' ]
        = 'bytes'
    ]
    if [str.eq name, 'fs.exists'] [ = 'str' ]
    if [str.eq name, 'fs.remove'] [ = 'str' ]
    if [str.eq name, 'fs.rename'] [ = 'str' ]
    if [str.eq name, 'fs.mkdir'] [ = 'str' ]
    if [str.eq name, 'fs.rmdir'] [ = 'str' ]
    if [str.eq name, 'fs.chdir'] [ = 'str' ]
    if [str.eq name, 'fs.list'] [ = 'str' ]
    if [str.eq name, 'path.join'] [ = 'str' ]
    if [str.eq name, 'path.dirname'] [ = 'str' ]
    if [str.eq name, 'path.basename'] [ = 'str' ]
    if [str.eq name, 'path.ext'] [ = 'str' ]
    if [str.eq name, 'path.normalize'] [ = 'str' ]
    if [str.eq name, 'process.run'] [ = 'str' ]
    if [str.eq name, 'process.env'] [ = 'str' ]
    if [str.eq name, 'str.len'] [ = 'str' ]
    if [str.eq name, 'str.at'] [
        if [index eq 0] [ = 'str' ]
        = 'int'
    ]
    if [str.eq name, 'str.slice'] [
        if [index eq 0] [ = 'str' ]
        = 'int'
    ]
    if [str.eq name, 'str.concat'] [ = 'str' ]
    if [str.eq name, 'str.eq'] [ = 'str' ]
    if [str.eq name, 'str.starts'] [ = 'str' ]
    if [str.eq name, 'str.trim'] [ = 'str' ]
    if [str.eq name, 'str.chr'] [ = 'int' ]
    if [str.eq name, 'bytes.from_str'] [ = 'str' ]
    if [str.eq name, 'bytes.to_str'] [ = 'bytes' ]
    if [str.eq name, 'bytes.alloc'] [ = 'int' ]
    if [str.eq name, 'bytes.len'] [ = 'bytes' ]
    if [str.eq name, 'bytes.at'] [
        if [index eq 0] [ = 'bytes' ]
        = 'int'
    ]
    if [str.eq name, 'bytes.set'] [
        if [index eq 0] [ = 'bytes' ]
        = 'int'
    ]
    if [str.eq name, 'bytes.slice'] [
        if [index eq 0] [ = 'bytes' ]
        = 'int'
    ]
    if [str.eq name, 'bytes.concat'] [ = 'bytes' ]
    if [str.eq name, 'bytes.eq'] [ = 'bytes' ]
    if [str.eq name, 'bytes.ptr'] [ = 'bytes' ]
    if [str.eq name, 'bytes.free'] [ = 'bytes' ]
    if [str.eq name, 'int.str'] [ = 'int' ]
    str key = fn_param_key name, index
    = map_get g_fn_params, key
]

fn is_integer_like [str typ] int [
    if [str.eq typ, 'int' or str.eq typ, 'char'] [ = 1 ]
    = 0
]

fn is_pointer_like [str typ] int [
    if [str.eq typ, 'str' or str.eq typ, 'bytes' or str.starts typ, 'ptr '] [ = 1 ]
    = 0
]

fn is_null_pointer_type [str typ] int [
    if [str.eq typ, 'ptr any'] [ = 1 ]
    = 0
]

fn can_boolify [str typ] int [
    if [str.eq typ, 'bool' or is_integer_like typ or str.eq typ, 'float' or is_pointer_like typ] [ = 1 ]
    = 0
]

fn operator_type_error [str op, str left_type, str right_type, int line, int start, int finish] int [
    str msg = 'operator '
    msg = str.concat msg, op
    msg = str.concat msg, ' does not support '
    msg = str.concat msg, left_type
    msg = str.concat msg, ' and '
    msg = str.concat msg, right_type
    = fail_at msg, line, start, finish
]

fn boolify [str op, str typ] str [
    if [str.eq typ, 'bool'] [ = op ]
    if [not can_boolify typ] [
        str msg = str.concat 'condition cannot use value of type ', typ
        fail_prev msg
        = '0'
    ]
    if [is_pointer_like typ] [ = ir_truthy_pointer op ]
    if [str.eq typ, 'float'] [ = ir_truthy_float op ]
    = ir_truthy_int op
]

fn intify [str op, str typ] str [
    if [str.eq typ, 'int' or str.eq typ, 'char'] [ = op ]
    if [str.eq typ, 'bool'] [ = ir_bool_to_int op ]
    = op
]

fn floatify [str op, str typ] str [
    if [str.eq typ, 'float'] [ = op ]
    if [is_integer_like typ] [ = ir_int_to_float op ]
    if [str.eq typ, 'bool'] [ = ir_bool_to_float op ]
    = op
]

fn can_cast [str from, str to] int [
    if [str.eq from, to] [ = 1 ]
    if [str.eq to, 'bool'] [
        if [can_boolify from] [ = 1 ]
        = 0
    ]
    if [str.eq to, 'int' or str.eq to, 'char'] [
        if [str.eq from, 'int' or str.eq from, 'char' or str.eq from, 'bool'] [ = 1 ]
        = 0
    ]
    if [str.eq to, 'float'] [
        if [is_integer_like from] [ = 1 ]
        = 0
    ]
    # `null` has the internal type `ptr any` and is the only pointer value
    # that implicitly adapts to a concrete pointer/string/bytes destination.
    if [str.eq to, 'str' and is_null_pointer_type from] [ = 1 ]
    if [str.eq to, 'bytes' and is_null_pointer_type from] [ = 1 ]
    if [str.starts to, 'ptr ' and is_null_pointer_type from] [ = 1 ]
    = 0
]

fn can_explicit_cast [str from, str to] int [
    if [can_cast from, to] [ = 1 ]
    if [str.eq from, 'float' and str.eq to, 'int'] [ = 1 ]
    if [str.eq from, 'float' and str.eq to, 'char'] [ = 1 ]
    if [str.eq from, 'float' and str.eq to, 'bool'] [ = 1 ]
    if [str.eq from, 'bool' and str.eq to, 'float'] [ = 1 ]
    if [is_pointer_like from and is_pointer_like to] [ = 1 ]
    = 0
]

fn cast_value [str op, str from, str to] str [
    if [str.eq from, to] [ = op ]
    if [str.eq to, 'bool'] [ = boolify op, from ]
    if [str.eq to, 'int' or str.eq to, 'char'] [
        if [str.eq from, 'float'] [ = ir_float_to_int op ]
        = intify op, from
    ]
    if [str.eq to, 'float'] [ = floatify op, from ]
    # Pointer reinterpretation is type-only in Lith IR. The backend decides
    # whether a target representation requires a machine instruction.
    if [is_pointer_like from and is_pointer_like to] [ = op ]
    = op
]

fn checked_cast [str op, str from, str to] str [
    if [can_cast from, to] [ = cast_value op, from, to ]
    str msg = 'type mismatch: expected '
    msg = str.concat msg, to
    msg = str.concat msg, ', got '
    msg = str.concat msg, from
    fail_prev msg
    = op
]

fn explicit_cast [str op, str from, str to, int line, int start, int finish] str [
    if [can_explicit_cast from, to] [ = cast_value op, from, to ]
    str msg = 'invalid explicit cast: '
    msg = str.concat msg, from
    msg = str.concat msg, ' as '
    msg = str.concat msg, to
    fail_at msg, line, start, finish
    = op
]

fn emit_numeric_compare [str op, str left, str left_type, str right, str right_type] str [
    if [is_integer_like left_type and is_integer_like right_type] [
        = ir_compare_int op, left, right
    ]
    str a = left
    str b = right
    if [str.eq left_type, 'float' and is_integer_like right_type] [ b = floatify right, right_type ]
    else [
        if [is_integer_like left_type and str.eq right_type, 'float'] [ a = floatify left, left_type ]
    ]
    = ir_compare_float op, a, b
]

fn emit_numeric_arithmetic [str op, str left, str left_type, str right, str right_type] str [
    if [is_integer_like left_type and is_integer_like right_type] [
        g_expr_type = 'int'
        = ir_arith_int op, left, right
    ]
    str a = left
    str b = right
    if [is_integer_like left_type] [ a = floatify left, left_type ]
    if [is_integer_like right_type] [ b = floatify right, right_type ]
    g_expr_type = 'float'
    = ir_arith_float op, a, b
]

fn numeric_pair [str left_type, str right_type] int [
    if [is_integer_like left_type and is_integer_like right_type] [ = 1 ]
    if [str.eq left_type, 'float' and str.eq right_type, 'float'] [ = 1 ]
    if [str.eq left_type, 'float' and is_integer_like right_type] [ = 1 ]
    if [is_integer_like left_type and str.eq right_type, 'float'] [ = 1 ]
    = 0
]

fn emit_binary [str op, str left, str left_type, str right, str right_type, int op_line, int op_start, int op_end] str [
    if [str.eq op, 'and' or str.eq op, 'or'] [
        if [not can_boolify left_type or not can_boolify right_type] [
            operator_type_error op, left_type, right_type, op_line, op_start, op_end
            g_expr_type = 'bool'
            g_expr_addr = ''
            = '0'
        ]
        str a = boolify left, left_type
        str b = boolify right, right_type
        str r = ir_logic op, a, b
        g_expr_type = 'bool'
        g_expr_addr = ''
        = r
    ]

    if [str.eq op, 'eq' or str.eq op, 'ne'] [
        if [str.eq left_type, 'str' and str.eq right_type, 'str'] [
            str args = ''
            args = ir_args_add args, 0, 'str', left
            args = ir_args_add args, 1, 'str', right
            str eqv = ir_call 'int', 'str.eq', args, 2
            str zero_op = 'ne'
            if [str.eq op, 'ne'] [ zero_op = 'eq' ]
            str sr = ir_compare_int zero_op, eqv, '0'
            g_expr_type = 'bool'
            g_expr_addr = ''
            = sr
        ]

        if [is_pointer_like left_type and is_pointer_like right_type] [
            if [not str.eq left_type, right_type and not is_null_pointer_type left_type and not is_null_pointer_type right_type] [
                operator_type_error op, left_type, right_type, op_line, op_start, op_end
                g_expr_type = 'bool'
                g_expr_addr = ''
                = '0'
            ]
            str pr = ir_compare_pointer op, left, right
            g_expr_type = 'bool'
            g_expr_addr = ''
            = pr
        ]

        if [str.eq left_type, 'bool' and str.eq right_type, 'bool'] [
            str br = ir_compare_bool op, left, right
            g_expr_type = 'bool'
            g_expr_addr = ''
            = br
        ]

        if [is_integer_like left_type and is_integer_like right_type] [
            str irv = ir_compare_int op, left, right
            g_expr_type = 'bool'
            g_expr_addr = ''
            = irv
        ]

        if [numeric_pair left_type, right_type] [
            str fa = left
            str fb = right
            if [is_integer_like left_type] [ fa = floatify left, left_type ]
            if [is_integer_like right_type] [ fb = floatify right, right_type ]
            str fr = ir_compare_float op, fa, fb
            g_expr_type = 'bool'
            g_expr_addr = ''
            = fr
        ]

        operator_type_error op, left_type, right_type, op_line, op_start, op_end
        g_expr_type = 'bool'
        g_expr_addr = ''
        = '0'
    ]

    if [str.eq op, 'gt' or str.eq op, 'lt' or str.eq op, 'ge' or str.eq op, 'le'] [
        if [numeric_pair left_type, right_type] [
            str cmp = emit_numeric_compare op, left, left_type, right, right_type
            g_expr_type = 'bool'
            g_expr_addr = ''
            = cmp
        ]
        operator_type_error op, left_type, right_type, op_line, op_start, op_end
        g_expr_type = 'bool'
        g_expr_addr = ''
        = '0'
    ]

    if [str.eq op, 'add' or str.eq op, 'sub' or str.eq op, 'mul' or str.eq op, 'div' or str.eq op, 'mod'] [
        if [numeric_pair left_type, right_type] [
            str out = emit_numeric_arithmetic op, left, left_type, right, right_type
            g_expr_addr = ''
            = out
        ]
        operator_type_error op, left_type, right_type, op_line, op_start, op_end
        g_expr_type = 'int'
        g_expr_addr = ''
        = '0'
    ]

    operator_type_error op, left_type, right_type, op_line, op_start, op_end
    g_expr_type = 'int'
    g_expr_addr = ''
    = '0'
]
