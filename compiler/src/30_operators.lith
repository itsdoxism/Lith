fn precedence [str op] int [
    if [str.eq op, 'or'] [ = 1 ]
    if [str.eq op, 'and'] [ = 2 ]
    if [str.eq op, 'eq'] [ = 3 ]
    if [str.eq op, 'ne'] [ = 3 ]
    if [str.eq op, 'gt'] [ = 3 ]
    if [str.eq op, 'lt'] [ = 3 ]
    if [str.eq op, 'ge'] [ = 3 ]
    if [str.eq op, 'le'] [ = 3 ]
    if [str.eq op, 'add'] [ = 4 ]
    if [str.eq op, 'sub'] [ = 4 ]
    if [str.eq op, 'mul'] [ = 5 ]
    if [str.eq op, 'div'] [ = 5 ]
    if [str.eq op, 'mod'] [ = 5 ]
    if [str.eq op, 'as'] [ = 6 ]
    = 0
]

fn starts_expr [int unused] int [
    if [str.eq g_kind, 'int'] [ = 1 ]
    if [str.eq g_kind, 'float'] [ = 1 ]
    if [str.eq g_kind, 'str'] [ = 1 ]
    if [str.eq g_kind, 'lb'] [ = 1 ]
    if [str.eq g_kind, 'id'] [ = 1 ]
    = 0
]

fn mapped_name [str name] str [
    if [str.eq name, 'io.read_text'] [ = 'luna_read_text' ]
    if [str.eq name, 'io.write_text'] [ = 'luna_write_text' ]
    if [str.eq name, 'str.len'] [ = 'luna_str_len' ]
    if [str.eq name, 'str.at'] [ = 'luna_str_at' ]
    if [str.eq name, 'str.slice'] [ = 'luna_str_slice' ]
    if [str.eq name, 'str.concat'] [ = 'luna_str_concat' ]
    if [str.eq name, 'str.eq'] [ = 'luna_str_eq' ]
    if [str.eq name, 'str.starts'] [ = 'luna_str_starts' ]
    if [str.eq name, 'str.trim'] [ = 'luna_str_trim' ]
    if [str.eq name, 'str.chr'] [ = 'luna_str_chr' ]
    if [str.eq name, 'int.str'] [ = 'luna_int_str' ]
    = name
]

fn builtin_ret [str name] str [
    if [str.eq name, 'io.read_text'] [ = 'str' ]
    if [str.eq name, 'io.write_text'] [ = 'int' ]
    if [str.eq name, 'str.len'] [ = 'int' ]
    if [str.eq name, 'str.at'] [ = 'int' ]
    if [str.eq name, 'str.slice'] [ = 'str' ]
    if [str.eq name, 'str.concat'] [ = 'str' ]
    if [str.eq name, 'str.eq'] [ = 'int' ]
    if [str.eq name, 'str.starts'] [ = 'int' ]
    if [str.eq name, 'str.trim'] [ = 'str' ]
    if [str.eq name, 'str.chr'] [ = 'str' ]
    if [str.eq name, 'int.str'] [ = 'str' ]
    = map_get g_fn_ret, name
]

fn builtin_argc [str name] int [
    if [str.eq name, 'io.read_text'] [ = 1 ]
    if [str.eq name, 'io.write_text'] [ = 2 ]
    if [str.eq name, 'str.len'] [ = 1 ]
    if [str.eq name, 'str.at'] [ = 2 ]
    if [str.eq name, 'str.slice'] [ = 3 ]
    if [str.eq name, 'str.concat'] [ = 2 ]
    if [str.eq name, 'str.eq'] [ = 2 ]
    if [str.eq name, 'str.starts'] [ = 2 ]
    if [str.eq name, 'str.trim'] [ = 1 ]
    if [str.eq name, 'str.chr'] [ = 1 ]
    if [str.eq name, 'int.str'] [ = 1 ]
    str n = map_get g_fn_argc, name
    if [str.eq n, ''] [ = 0 ]
    = 0
]

fn call_argc_text [str name] str [
    int builtin = builtin_argc name
    if [builtin gt 0] [ = int.str builtin ]
    = map_get g_fn_argc, name
]

fn builtin_param [str name, int index] str [
    if [str.eq name, 'io.read_text'] [ = 'str' ]
    if [str.eq name, 'io.write_text'] [ = 'str' ]
    if [str.eq name, 'str.len'] [ = 'str' ]
    if [str.eq name, 'str.at'] [
        if [index eq 0] [ = 'str' ]
        = 'int'
    ]
    if [str.eq name, 'str.slice'] [
        if [index eq 0] [ = 'str' ]
        = 'int'
    ]
    if [str.eq name, 'str.concat'] [ = 'str' ]
    if [str.eq name, 'str.eq'] [ = 'str' ]
    if [str.eq name, 'str.starts'] [ = 'str' ]
    if [str.eq name, 'str.trim'] [ = 'str' ]
    if [str.eq name, 'str.chr'] [ = 'int' ]
    if [str.eq name, 'int.str'] [ = 'int' ]
    str key = fn_param_key name, index
    = map_get g_fn_params, key
]

fn is_integer_like [str typ] int [
    if [str.eq typ, 'int' or str.eq typ, 'char'] [ = 1 ]
    = 0
]

fn is_pointer_like [str typ] int [
    if [str.eq typ, 'str' or str.starts typ, 'ptr '] [ = 1 ]
    = 0
]

fn is_null_pointer_type [str typ] int [
    if [str.eq typ, 'ptr any'] [ = 1 ]
    = 0
]

fn can_boolify [str typ] int [
    if [str.eq typ, 'bool' or is_integer_like typ or str.eq typ, 'float' or is_pointer_like typ] [ = 1 ]
    = 0
]

fn operator_type_error [str op, str left_type, str right_type, int line, int start, int finish] int [
    str msg = 'operator '
    msg = str.concat msg, op
    msg = str.concat msg, ' does not support '
    msg = str.concat msg, left_type
    msg = str.concat msg, ' and '
    msg = str.concat msg, right_type
    = fail_at msg, line, start, finish
]

fn boolify [str op, str typ] str [
    if [str.eq typ, 'bool'] [ = op ]
    if [not can_boolify typ] [
        str msg = str.concat 'condition cannot use value of type ', typ
        fail_prev msg
        = '0'
    ]
    str r = new_reg 0
    if [is_pointer_like typ] [
        str s = str.concat r, ' = icmp ne ptr '
        s = str.concat s, op
        s = str.concat s, ', null'
        emit_inst s
        = r
    ]
    if [str.eq typ, 'float'] [
        str sf = str.concat r, ' = fcmp une double '
        sf = str.concat sf, op
        sf = str.concat sf, ', 0.0'
        emit_inst sf
        = r
    ]
    str s2 = str.concat r, ' = icmp ne i32 '
    s2 = str.concat s2, op
    s2 = str.concat s2, ', 0'
    emit_inst s2
    = r
]

fn intify [str op, str typ] str [
    if [str.eq typ, 'int' or str.eq typ, 'char'] [ = op ]
    if [str.eq typ, 'bool'] [
        str r = new_reg 0
        str s = str.concat r, ' = zext i1 '
        s = str.concat s, op
        s = str.concat s, ' to i32'
        emit_inst s
        = r
    ]
    = op
]

fn floatify [str op, str typ] str [
    if [str.eq typ, 'float'] [ = op ]
    if [is_integer_like typ] [
        str r = new_reg 0
        str s = str.concat r, ' = sitofp i32 '
        s = str.concat s, op
        s = str.concat s, ' to double'
        emit_inst s
        = r
    ]
    if [str.eq typ, 'bool'] [
        str r2 = new_reg 0
        str s2 = str.concat r2, ' = uitofp i1 '
        s2 = str.concat s2, op
        s2 = str.concat s2, ' to double'
        emit_inst s2
        = r2
    ]
    = op
]

fn can_cast [str from, str to] int [
    if [str.eq from, to] [ = 1 ]
    if [str.eq to, 'bool'] [
        if [can_boolify from] [ = 1 ]
        = 0
    ]
    if [str.eq to, 'int' or str.eq to, 'char'] [
        if [str.eq from, 'int' or str.eq from, 'char' or str.eq from, 'bool'] [ = 1 ]
        = 0
    ]
    if [str.eq to, 'float'] [
        if [is_integer_like from] [ = 1 ]
        = 0
    ]
    # `null` has the internal type `ptr any` and is the only pointer value
    # that implicitly adapts to a concrete pointer/string destination.
    if [str.eq to, 'str' and is_null_pointer_type from] [ = 1 ]
    if [str.starts to, 'ptr ' and is_null_pointer_type from] [ = 1 ]
    = 0
]

fn can_explicit_cast [str from, str to] int [
    if [can_cast from, to] [ = 1 ]
    if [str.eq from, 'float' and str.eq to, 'int'] [ = 1 ]
    if [str.eq from, 'float' and str.eq to, 'char'] [ = 1 ]
    if [str.eq from, 'float' and str.eq to, 'bool'] [ = 1 ]
    if [str.eq from, 'bool' and str.eq to, 'float'] [ = 1 ]
    if [is_pointer_like from and is_pointer_like to] [ = 1 ]
    = 0
]

fn cast_value [str op, str from, str to] str [
    if [str.eq from, to] [ = op ]
    if [str.eq to, 'bool'] [ = boolify op, from ]
    if [str.eq to, 'int' or str.eq to, 'char'] [
        if [str.eq from, 'float'] [
            str r = new_reg 0
            str s = str.concat r, ' = fptosi double '
            s = str.concat s, op
            s = str.concat s, ' to i32'
            emit_inst s
            = r
        ]
        = intify op, from
    ]
    if [str.eq to, 'float'] [ = floatify op, from ]
    if [is_pointer_like from and is_pointer_like to] [ = op ]
    = op
]

fn checked_cast [str op, str from, str to] str [
    if [can_cast from, to] [ = cast_value op, from, to ]
    str msg = 'type mismatch: expected '
    msg = str.concat msg, to
    msg = str.concat msg, ', got '
    msg = str.concat msg, from
    fail_prev msg
    = op
]

fn explicit_cast [str op, str from, str to, int line, int start, int finish] str [
    if [can_explicit_cast from, to] [ = cast_value op, from, to ]
    str msg = 'invalid explicit cast: '
    msg = str.concat msg, from
    msg = str.concat msg, ' as '
    msg = str.concat msg, to
    fail_at msg, line, start, finish
    = op
]

fn emit_numeric_compare [str op, str left, str lt, str right, str rt] str [
    if [is_integer_like lt and is_integer_like rt] [
        str pred = 'sgt'
        if [str.eq op, 'lt'] [ pred = 'slt' ]
        if [str.eq op, 'ge'] [ pred = 'sge' ]
        if [str.eq op, 'le'] [ pred = 'sle' ]
        str r = new_reg 0
        str s = str.concat r, ' = icmp '
        s = str.concat s, pred
        s = str.concat s, ' i32 '
        s = str.concat s, left
        s = str.concat s, ', '
        s = str.concat s, right
        emit_inst s
        = r
    ]
    str a = left
    str b = right
    if [str.eq lt, 'float' and is_integer_like rt] [ b = floatify right, rt ]
    else [
        if [is_integer_like lt and str.eq rt, 'float'] [ a = floatify left, lt ]
    ]
    str fpred = 'ogt'
    if [str.eq op, 'lt'] [ fpred = 'olt' ]
    if [str.eq op, 'ge'] [ fpred = 'oge' ]
    if [str.eq op, 'le'] [ fpred = 'ole' ]
    str fr = new_reg 0
    str fs = str.concat fr, ' = fcmp '
    fs = str.concat fs, fpred
    fs = str.concat fs, ' double '
    fs = str.concat fs, a
    fs = str.concat fs, ', '
    fs = str.concat fs, b
    emit_inst fs
    = fr
]

fn emit_numeric_arithmetic [str op, str left, str lt, str right, str rt] str [
    if [is_integer_like lt and is_integer_like rt] [
        str inst = 'add'
        if [str.eq op, 'sub'] [ inst = 'sub' ]
        if [str.eq op, 'mul'] [ inst = 'mul' ]
        if [str.eq op, 'div'] [ inst = 'sdiv' ]
        if [str.eq op, 'mod'] [ inst = 'srem' ]
        str r = new_reg 0
        str s = str.concat r, ' = '
        s = str.concat s, inst
        s = str.concat s, ' i32 '
        s = str.concat s, left
        s = str.concat s, ', '
        s = str.concat s, right
        emit_inst s
        g_expr_type = 'int'
        = r
    ]
    str a = left
    str b = right
    if [is_integer_like lt] [ a = floatify left, lt ]
    if [is_integer_like rt] [ b = floatify right, rt ]
    str finst = 'fadd'
    if [str.eq op, 'sub'] [ finst = 'fsub' ]
    if [str.eq op, 'mul'] [ finst = 'fmul' ]
    if [str.eq op, 'div'] [ finst = 'fdiv' ]
    if [str.eq op, 'mod'] [ finst = 'frem' ]
    str fr = new_reg 0
    str fs = str.concat fr, ' = '
    fs = str.concat fs, finst
    fs = str.concat fs, ' double '
    fs = str.concat fs, a
    fs = str.concat fs, ', '
    fs = str.concat fs, b
    emit_inst fs
    g_expr_type = 'float'
    = fr
]

fn numeric_pair [str lt, str rt] int [
    if [is_integer_like lt and is_integer_like rt] [ = 1 ]
    if [str.eq lt, 'float' and str.eq rt, 'float'] [ = 1 ]
    if [str.eq lt, 'float' and is_integer_like rt] [ = 1 ]
    if [is_integer_like lt and str.eq rt, 'float'] [ = 1 ]
    = 0
]

fn emit_binary [str op, str left, str lt, str right, str rt, int op_line, int op_start, int op_end] str [
    if [str.eq op, 'and' or str.eq op, 'or'] [
        if [not can_boolify lt or not can_boolify rt] [
            operator_type_error op, lt, rt, op_line, op_start, op_end
            g_expr_type = 'bool'
            g_expr_addr = ''
            = '0'
        ]
        str a = boolify left, lt
        str b = boolify right, rt
        str r = new_reg 0
        str inst = 'and'
        if [str.eq op, 'or'] [ inst = 'or' ]
        str s = str.concat r, ' = '
        s = str.concat s, inst
        s = str.concat s, ' i1 '
        s = str.concat s, a
        s = str.concat s, ', '
        s = str.concat s, b
        emit_inst s
        g_expr_type = 'bool'
        g_expr_addr = ''
        = r
    ]

    if [str.eq op, 'eq' or str.eq op, 'ne'] [
        str pred = 'eq'
        if [str.eq op, 'ne'] [ pred = 'ne' ]

        if [str.eq lt, 'str' and str.eq rt, 'str'] [
            str eqv = new_reg 0
            str call = str.concat eqv, ' = call i32 @luna_str_eq(ptr '
            call = str.concat call, left
            call = str.concat call, ', ptr '
            call = str.concat call, right
            call = str.concat call, ')'
            emit_inst call
            str sr = new_reg 0
            str spred = 'ne'
            if [str.eq op, 'ne'] [ spred = 'eq' ]
            str ss = str.concat sr, ' = icmp '
            ss = str.concat ss, spred
            ss = str.concat ss, ' i32 '
            ss = str.concat ss, eqv
            ss = str.concat ss, ', 0'
            emit_inst ss
            g_expr_type = 'bool'
            g_expr_addr = ''
            = sr
        ]

        if [is_pointer_like lt and is_pointer_like rt] [
            str pr = new_reg 0
            str ps = str.concat pr, ' = icmp '
            ps = str.concat ps, pred
            ps = str.concat ps, ' ptr '
            ps = str.concat ps, left
            ps = str.concat ps, ', '
            ps = str.concat ps, right
            emit_inst ps
            g_expr_type = 'bool'
            g_expr_addr = ''
            = pr
        ]

        if [str.eq lt, 'bool' and str.eq rt, 'bool'] [
            str br = new_reg 0
            str bs = str.concat br, ' = icmp '
            bs = str.concat bs, pred
            bs = str.concat bs, ' i1 '
            bs = str.concat bs, left
            bs = str.concat bs, ', '
            bs = str.concat bs, right
            emit_inst bs
            g_expr_type = 'bool'
            g_expr_addr = ''
            = br
        ]

        if [is_integer_like lt and is_integer_like rt] [
            str ir = new_reg 0
            str is = str.concat ir, ' = icmp '
            is = str.concat is, pred
            is = str.concat is, ' i32 '
            is = str.concat is, left
            is = str.concat is, ', '
            is = str.concat is, right
            emit_inst is
            g_expr_type = 'bool'
            g_expr_addr = ''
            = ir
        ]

        if [numeric_pair lt, rt] [
            str fa = left
            str fb = right
            if [is_integer_like lt] [ fa = floatify left, lt ]
            if [is_integer_like rt] [ fb = floatify right, rt ]
            str fpred = 'oeq'
            if [str.eq op, 'ne'] [ fpred = 'une' ]
            str fr = new_reg 0
            str fs = str.concat fr, ' = fcmp '
            fs = str.concat fs, fpred
            fs = str.concat fs, ' double '
            fs = str.concat fs, fa
            fs = str.concat fs, ', '
            fs = str.concat fs, fb
            emit_inst fs
            g_expr_type = 'bool'
            g_expr_addr = ''
            = fr
        ]

        operator_type_error op, lt, rt, op_line, op_start, op_end
        g_expr_type = 'bool'
        g_expr_addr = ''
        = '0'
    ]

    if [str.eq op, 'gt' or str.eq op, 'lt' or str.eq op, 'ge' or str.eq op, 'le'] [
        if [numeric_pair lt, rt] [
            str cmp = emit_numeric_compare op, left, lt, right, rt
            g_expr_type = 'bool'
            g_expr_addr = ''
            = cmp
        ]
        operator_type_error op, lt, rt, op_line, op_start, op_end
        g_expr_type = 'bool'
        g_expr_addr = ''
        = '0'
    ]

    if [str.eq op, 'add' or str.eq op, 'sub' or str.eq op, 'mul' or str.eq op, 'div' or str.eq op, 'mod'] [
        if [numeric_pair lt, rt] [
            str out = emit_numeric_arithmetic op, left, lt, right, rt
            g_expr_addr = ''
            = out
        ]
        operator_type_error op, lt, rt, op_line, op_start, op_end
        g_expr_type = 'int'
        g_expr_addr = ''
        = '0'
    ]

    operator_type_error op, lt, rt, op_line, op_start, op_end
    g_expr_type = 'int'
    g_expr_addr = ''
    = '0'
]
