            current_addr = gep
        ]
        while [str.eq g_kind, 'dot'] [
            next_tok 0
            if [not str.eq g_kind, 'id'] [
                fail 'expected struct field'
                = value
            ]
            str field = g_text
            next_tok 0
            if [not is_struct_type current_type] [
                fail 'member access on non struct'
                = value
            ]
            str field_index = struct_field_index current_type, field
            str field_type = struct_field_type current_type, field
            if [str.eq field_index, '' or str.eq field_type, ''] [
                fail 'unknown struct field'
                = value
            ]
            str field_addr = new_reg 0
            str fs = str.concat field_addr, ' = getelementptr inbounds '
            fs = str.concat fs, storage_type current_type
            fs = str.concat fs, ', ptr '
            fs = str.concat fs, current_addr
            fs = str.concat fs, ', i32 0, i32 '
            fs = str.concat fs, field_index
            emit_inst fs
            str field_value = new_reg 0
            str fl = str.concat field_value, ' = load '
            fl = str.concat fl, storage_type field_type
            fl = str.concat fl, ', ptr '
            fl = str.concat fl, field_addr
            emit_inst fl
            value = field_value
            current_type = field_type
            current_addr = field_addr
        ]
        g_expr_type = current_type
        g_expr_addr = current_addr
        = value
    ]
    fail 'expected expression'
    g_expr_type = 'int'
    g_expr_addr = ''
    = '0'
]

fn pointee_type [str typ] str [
    if [str.starts typ, 'ptr '] [
        = str.slice typ, 4, str.len typ
    ]
    = 'int'
]

fn emit_alloc_size [str target_type, str count] str [
    str elem = pointee_type target_type
    str sizeptr = new_reg 0
    str gs = str.concat sizeptr, ' = getelementptr '
    gs = str.concat gs, storage_type elem
    gs = str.concat gs, ', ptr null, i32 '
    gs = str.concat gs, count
    emit_inst gs
    str bytes = new_reg 0
    str ps = str.concat bytes, ' = ptrtoint ptr '
    ps = str.concat ps, sizeptr
    ps = str.concat ps, ' to i64'
    emit_inst ps
    = bytes
]

fn emit_sys_memory [str target_type] str [
    expect_id 'sys'
    expect_kind 'dot'
    str method = g_text
    next_tok 0

    if [str.eq method, 'alloc'] [
        str count = parse_expr 6
        str count_type = g_expr_type
        count = intify count, count_type
        str bytes = emit_alloc_size target_type, count
        str out = new_reg 0
        str call = str.concat out, ' = call ptr @malloc(i64 '
        call = str.concat call, bytes
        call = str.concat call, ')'
        emit_inst call
        g_expr_type = target_type
        g_expr_addr = ''
        = out
    ]

    if [str.eq method, 'realloc'] [
        str old = parse_expr 6
        str old_type = g_expr_type
        if [str.eq g_kind, 'comma'] [ next_tok 0 ]
        else [ fail 'sys.realloc expects pointer and count' ]
        str count2 = parse_expr 6
        str count_type2 = g_expr_type
        count2 = intify count2, count_type2
        str actual_type = target_type
        if [not str.starts actual_type, 'ptr '] [ actual_type = old_type ]
        str bytes2 = emit_alloc_size actual_type, count2
        str out2 = new_reg 0
        str call2 = str.concat out2, ' = call ptr @realloc(ptr '
        call2 = str.concat call2, old
        call2 = str.concat call2, ', i64 '
        call2 = str.concat call2, bytes2
        call2 = str.concat call2, ')'
        emit_inst call2
        g_expr_type = actual_type
        g_expr_addr = ''
        = out2
    ]

    if [str.eq method, 'free'] [
        str old2 = parse_expr 6
        str call3 = str.concat 'call void @free(ptr ', old2
        call3 = str.concat call3, ')'
        emit_inst call3
        g_expr_type = 'int'
        g_expr_addr = ''
        = '0'
    ]

    fail 'unknown sys memory operation'
    g_expr_type = target_type
    g_expr_addr = ''
    = '0'
]

fn parse_decl_ir [int unused] int [
    str typ = parse_type 0
    str name = g_text
    next_tok 0
    expect_kind 'assign'
    g_locals = map_put g_locals, name, typ
    str addr = new_reg 0
    g_local_addrs = map_put g_local_addrs, name, addr
    str a = str.concat addr, ' = alloca '
    emit_inst str.concat a, llvm_type typ
    str value = ''
    if [str.eq g_kind, 'id' and str.eq g_text, 'sys'] [
        value = emit_sys_memory typ
    ]
    else [
        value = parse_expr 0
    ]
    str vt = g_expr_type
    value = cast_value value, vt, typ
    str st = str.concat 'store ', llvm_type typ
    st = str.concat st, ' '
    st = str.concat st, value
    st = str.concat st, ', ptr '
    st = str.concat st, addr
    emit_inst st
    = 0
]

fn parse_stmt_ir [int unused] int [
    skip_nl 0
    if [str.eq g_kind, 'id' and str.eq g_text, 'if'] [
        next_tok 0
        expect_kind 'lb'
        str cond = parse_expr 0
        str ct = g_expr_type
        cond = boolify cond, ct
        expect_kind 'rb'
        str yes = new_label 'if.then'
        str no = new_label 'if.else'
        str done = new_label 'if.end'
        emit_cbranch cond, yes, no
        emit_label yes
        parse_block_ir 0
        int yes_term = g_terminated
        if [yes_term eq 0] [ emit_branch done ]
        skip_nl 0
        if [str.eq g_kind, 'id' and str.eq g_text, 'else'] [
            next_tok 0
            emit_label no
            parse_block_ir 0
            int no_term = g_terminated
            if [no_term eq 0] [ emit_branch done ]
            emit_label done
            if [yes_term and no_term] [ emit_unreachable 0 ]
        ]
        else [
            emit_label no
            emit_branch done
            emit_label done
        ]
        = 0
    ]
    if [str.eq g_kind, 'id' and str.eq g_text, 'while'] [
        next_tok 0
        str cond_label = new_label 'while.cond'
        str body_label = new_label 'while.body'
        str end_label = new_label 'while.end'
        emit_branch cond_label
        emit_label cond_label
        expect_kind 'lb'
        str condw = parse_expr 0
        str cwt = g_expr_type
        condw = boolify condw, cwt
        expect_kind 'rb'
        emit_cbranch condw, body_label, end_label
        emit_label body_label
        str old_break = g_break_label
        str old_continue = g_continue_label
        g_break_label = end_label
        g_continue_label = cond_label
        parse_block_ir 0
        g_break_label = old_break
        g_continue_label = old_continue
        if [g_terminated eq 0] [ emit_branch cond_label ]
        emit_label end_label
        = 0
    ]
    if [str.eq g_kind, 'id' and str.eq g_text, 'break'] [
        next_tok 0
        emit_branch g_break_label
        = 0
    ]
    if [str.eq g_kind, 'id' and str.eq g_text, 'continue'] [
        next_tok 0
        emit_branch g_continue_label
        = 0
    ]
    if [str.eq g_kind, 'assign'] [
        next_tok 0
        str rv = parse_expr 0
        str rt = g_expr_type
        rv = cast_value rv, rt, g_current_ret
        emit_return g_current_ret, rv
        = 0
    ]
    if [str.eq g_kind, 'id' and str.eq g_text, 'return'] [
        next_tok 0
        str rv2 = parse_expr 0
        str rt2 = g_expr_type
        rv2 = cast_value rv2, rt2, g_current_ret
        emit_return g_current_ret, rv2
        = 0
    ]
    if [str.eq g_kind, 'id' and is_decl_type g_text] [
        = parse_decl_ir 0
    ]
    if [str.eq g_kind, 'id' and str.eq g_text, 'sys'] [
        str ignored = emit_sys_memory 'ptr int'
        = 0
    ]
    str lhs = parse_expr 0
    str lhs_type = g_expr_type
    str lhs_addr = g_expr_addr
    if [str.eq g_kind, 'assign'] [
        next_tok 0
        str rhs = ''
        if [str.eq g_kind, 'id' and str.eq g_text, 'sys'] [
            rhs = emit_sys_memory lhs_type
        ]
        else [
            rhs = parse_expr 0
        ]
        str rhs_type = g_expr_type
        rhs = cast_value rhs, rhs_type, lhs_type
        str st = str.concat 'store ', storage_type lhs_type
        st = str.concat st, ' '
        st = str.concat st, rhs
        st = str.concat st, ', ptr '
        st = str.concat st, lhs_addr
        emit_inst st
        = 0
    ]
    = 0
]

fn parse_block_ir [int unused] int [
    expect_kind 'lb'
    skip_nl 0
    while [not str.eq g_kind, 'rb' and not str.eq g_kind, 'eof'] [
        parse_stmt_ir 0
        skip_nl 0
    ]
    expect_kind 'rb'
    = 0
]

fn skip_block [int unused] int [
    expect_kind 'lb'
    int depth = 1
    while [depth gt 0 and not str.eq g_kind, 'eof'] [
        if [str.eq g_kind, 'lb'] [ depth = depth add 1 ]
        if [str.eq g_kind, 'rb'] [ depth = depth sub 1 ]
        next_tok 0
    ]
    = 0
]

fn scan_struct [int unused] int [
    expect_id 'struct'
    str name = g_text
    next_tok 0
    expect_kind 'lb'
    skip_nl 0
    int index = 0
    while [not str.eq g_kind, 'rb' and not str.eq g_kind, 'eof'] [
        str typ = parse_type 0
        str field = g_text
        next_tok 0
        str key = struct_key name, field
        g_struct_indices = map_put g_struct_indices, key, int.str index
        g_struct_types = map_put g_struct_types, key, typ
        index = index add 1
        skip_nl 0
    ]
    expect_kind 'rb'
    g_struct_counts = map_put g_struct_counts, name, int.str index
    = 0
]

fn scan_function [int unused] int [
    expect_id 'fn'
    str name = g_text
    next_tok 0
    expect_kind 'lb'
    int argc = 0
    while [not str.eq g_kind, 'rb'] [
        str typ = parse_type 0
        str pname = g_text
        next_tok 0
        str pkey = fn_param_key name, argc
        g_fn_params = map_put g_fn_params, pkey, typ
        argc = argc add 1
        if [str.eq g_kind, 'comma'] [ next_tok 0 ]
        else [ break ]
    ]
    expect_kind 'rb'
    str ret = 'int'
    if [str.eq g_kind, 'id'] [
        ret = g_text
        next_tok 0
    ]
    g_fn_ret = map_put g_fn_ret, name, ret
    g_fn_argc = map_put g_fn_argc, name, int.str argc
    skip_block 0
    = 0
]

fn scan_global [int unused] int [
    str typ = parse_type 0
    str name = g_text
    next_tok 0
    expect_kind 'assign'
    g_globals = map_put g_globals, name, typ
    while [not str.eq g_kind, 'nl' and not str.eq g_kind, 'eof'] [ next_tok 0 ]
    = 0
]

fn scan_top [str source] int [
    g_globals = ''
    g_fn_ret = ''
    g_fn_argc = ''
    g_fn_params = ''
    g_struct_counts = ''
    g_struct_indices = ''
    g_struct_types = ''
    reset source
    skip_nl 0
    while [not str.eq g_kind, 'eof'] [
        if [str.eq g_kind, 'id' and str.eq g_text, 'use'] [
            next_tok 0
            next_tok 0
        ]
        else [
            if [str.eq g_kind, 'id' and str.eq g_text, 'struct'] [ scan_struct 0 ]
            else [
                if [str.eq g_kind, 'id' and str.eq g_text, 'fn'] [ scan_function 0 ]
                else [
                    if [str.eq g_kind, 'id' and is_decl_type g_text] [ scan_global 0 ]
                    else [ = fail 'unsupported top level item' ]
                ]
            ]
        ]
        skip_nl 0
    ]
    = 0
]

fn emit_struct_ir [int unused] int [
    expect_id 'struct'
    str name = g_text
    next_tok 0
    expect_kind 'lb'
    skip_nl 0
    str fields = ''
    int first = 1
    while [not str.eq g_kind, 'rb' and not str.eq g_kind, 'eof'] [
        str typ = parse_type 0
        next_tok 0
        if [first eq 0] [ fields = str.concat fields, ', ' ]
        fields = str.concat fields, storage_type typ
        first = 0
        skip_nl 0
    ]
    expect_kind 'rb'
    str s = str.concat '%struct.', name
    s = str.concat s, ' = type { '
    s = str.concat s, fields
    s = str.concat s, ' }'
    emit_line s
    emit_line ''
    = 0
]

fn emit_global_ir [int unused] int [
    str typ = parse_type 0
    str name = g_text
    next_tok 0
    expect_kind 'assign'
    str value = '0'
    if [str.eq g_kind, 'str'] [ value = string_const g_text ]
    else [ value = g_text ]
    next_tok 0
    str s = str.concat '@', name
    s = str.concat s, ' = global '
    s = str.concat s, storage_type typ
    s = str.concat s, ' '
    s = str.concat s, value
    emit_line s
    = 0
]

fn emit_function_ir [int unused] int [
    expect_id 'fn'
    str name = g_text
    next_tok 0
    expect_kind 'lb'
    str args = ''
    str prologue = ''
    g_locals = ''
    g_local_addrs = ''
    g_temp = 0
    int first = 1
    while [not str.eq g_kind, 'rb'] [
        str typ = parse_type 0
        str pname = g_text
        next_tok 0
        g_locals = map_put g_locals, pname, typ
        str paddr = new_reg 0
        g_local_addrs = map_put g_local_addrs, pname, paddr
        if [first eq 0] [ args = str.concat args, ', ' ]
        args = str.concat args, storage_type typ
        args = str.concat args, ' %arg.'
        args = str.concat args, pname
        str p1 = str.concat '  ', paddr
        p1 = str.concat p1, ' = alloca '
        p1 = str.concat p1, storage_type typ
        prologue = str.concat prologue, p1
        prologue = str.concat prologue, str.chr 10
        str p2 = str.concat '  store ', storage_type typ
        p2 = str.concat p2, ' %arg.'
        p2 = str.concat p2, pname
        p2 = str.concat p2, ', ptr '
        p2 = str.concat p2, paddr
        prologue = str.concat prologue, p2
        prologue = str.concat prologue, str.chr 10
        first = 0
        if [str.eq g_kind, 'comma'] [ next_tok 0 ]
        else [ break ]
    ]
    expect_kind 'rb'
    str ret = 'int'
    if [str.eq g_kind, 'id'] [
        ret = g_text
        next_tok 0
    ]
    g_current_ret = ret
    g_label = 0
    g_terminated = 0
    g_break_label = ''
    g_continue_label = ''
    str head = str.concat 'define ', storage_type ret
    head = str.concat head, ' @'
    head = str.concat head, name
    head = str.concat head, '('
    head = str.concat head, args
    head = str.concat head, ') {'
    emit_line head
    emit_label 'entry'
    g_out = str.concat g_out, prologue
    parse_block_ir 0
    if [g_terminated eq 0] [ emit_return ret, default_value ret ]
    emit_line '}'
    emit_line ''
    = 0
]

fn emit_header [int unused] int [
    emit_line '; Luna self-hosted LLVM backend'
    emit_line ''
    emit_line 'declare ptr @luna_read_text(ptr)'
    emit_line 'declare i32 @luna_write_text(ptr, ptr)'
    emit_line 'declare i32 @luna_str_len(ptr)'
    emit_line 'declare i32 @luna_str_at(ptr, i32)'
    emit_line 'declare ptr @luna_str_slice(ptr, i32, i32)'
    emit_line 'declare ptr @luna_str_concat(ptr, ptr)'
    emit_line 'declare i32 @luna_str_eq(ptr, ptr)'
    emit_line 'declare i32 @luna_str_starts(ptr, ptr)'
    emit_line 'declare ptr @luna_str_trim(ptr)'
    emit_line 'declare ptr @luna_str_chr(i32)'
    emit_line 'declare ptr @luna_int_str(i32)'
    emit_line 'declare ptr @malloc(i64)'
    emit_line 'declare ptr @realloc(ptr, i64)'
    emit_line 'declare void @free(ptr)'
    emit_line ''
    = 0
]

fn compile_llvm [str source] str [
    g_error = 0
    g_out = ''
    g_strings = ''
    g_string_id = 0
    scan_top source
    emit_header 0
    reset source
    skip_nl 0
    while [not str.eq g_kind, 'eof'] [
        if [str.eq g_kind, 'id' and str.eq g_text, 'use'] [
            next_tok 0
            next_tok 0
        ]
        else [
            if [str.eq g_kind, 'id' and str.eq g_text, 'struct'] [ emit_struct_ir 0 ]
            else [
                if [str.eq g_kind, 'id' and str.eq g_text, 'fn'] [ emit_function_ir 0 ]
                else [
                    if [str.eq g_kind, 'id' and is_decl_type g_text] [ emit_global_ir 0 ]
                    else [
                        fail 'unsupported top level item'
                        = ''
                    ]
                ]
            ]
        ]
        skip_nl 0
    ]
    g_out = str.concat g_out, g_strings
    = g_out
]

fn main [int argc, ptr str argv] int [
    if [argc lt 3] [ = 2 ]
    str source = io.read_text argv[1]
    str ir = compile_llvm source
    if [g_error] [ = 1 ]
    int ok = io.write_text argv[2], ir
    if [ok eq 0] [ = 1 ]
    = 0
]
