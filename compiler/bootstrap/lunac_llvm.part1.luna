# Luna LLVM compiler bootstrap subset, written in Luna.
# This compiler emits typed LLVM IR directly for the subset needed to compile itself.
use io
use str
use int

str g_src = ''
int g_pos = 0
int g_line = 1
str g_kind = 'eof'
str g_text = ''
int g_error = 0

str g_out = ''
str g_strings = ''
int g_string_id = 0
int g_temp = 0
int g_label = 0
int g_terminated = 0
str g_break_label = ''
str g_continue_label = ''
str g_current_ret = 'int'

str g_globals = ''
str g_locals = ''
str g_local_addrs = ''
str g_fn_ret = ''
str g_fn_argc = ''
str g_fn_params = ''

str g_expr_type = 'int'
str g_expr_addr = ''

fn append_char [str s, int c] str [
    = str.concat s, str.chr c
]

fn fail [str msg] int [
    g_error = 1
    = 0
]

fn is_alpha [int c] int [
    = c ge 65 and c le 90 or c ge 97 and c le 122 or c eq 95
]

fn is_digit [int c] int [
    = c ge 48 and c le 57
]

fn next_tok [int unused] int [
    int n = str.len g_src
    while [g_pos lt n] [
        int c = str.at g_src, g_pos
        if [c eq 32 or c eq 9 or c eq 13] [
            g_pos = g_pos add 1
            continue
        ]
        if [c eq 35] [
            while [g_pos lt n and str.at g_src, g_pos ne 10] [
                g_pos = g_pos add 1
            ]
            continue
        ]
        if [c eq 10] [
            g_pos = g_pos add 1
            g_line = g_line add 1
            g_kind = 'nl'
            g_text = ''
            = 0
        ]
        if [c eq 39] [
            g_pos = g_pos add 1
            str s = ''
            while [g_pos lt n] [
                int q = str.at g_src, g_pos
                if [q eq 39] [
                    g_pos = g_pos add 1
                    g_kind = 'str'
                    g_text = s
                    = 0
                ]
                if [q eq 92] [
                    g_pos = g_pos add 1
                    if [g_pos ge n] [ = fail 'unterminated escape' ]
                    int e = str.at g_src, g_pos
                    if [e eq 110] [ s = append_char s, 10 ]
                    else [
                        if [e eq 114] [ s = append_char s, 13 ]
                        else [
                            if [e eq 116] [ s = append_char s, 9 ]
                            else [ s = append_char s, e ]
                        ]
                    ]
                    g_pos = g_pos add 1
                    continue
                ]
                s = append_char s, q
                g_pos = g_pos add 1
            ]
            = fail 'unterminated string'
        ]
        if [is_alpha c] [
            int start = g_pos
            g_pos = g_pos add 1
            while [g_pos lt n] [
                int a = str.at g_src, g_pos
                if [not is_alpha a and not is_digit a] [ break ]
                g_pos = g_pos add 1
            ]
            g_kind = 'id'
            g_text = str.slice g_src, start, g_pos
            = 0
        ]
        if [is_digit c] [
            int startn = g_pos
            g_pos = g_pos add 1
            while [g_pos lt n and is_digit str.at g_src, g_pos] [
                g_pos = g_pos add 1
            ]
            g_kind = 'int'
            if [g_pos lt n and str.at g_src, g_pos eq 46] [
                g_pos = g_pos add 1
                while [g_pos lt n and is_digit str.at g_src, g_pos] [
                    g_pos = g_pos add 1
                ]
                g_kind = 'float'
            ]
            g_text = str.slice g_src, startn, g_pos
            = 0
        ]
        g_pos = g_pos add 1
        if [c eq 91] [ g_kind = 'lb' g_text = '[' = 0 ]
        if [c eq 93] [ g_kind = 'rb' g_text = ']' = 0 ]
        if [c eq 44] [ g_kind = 'comma' g_text = ',' = 0 ]
        if [c eq 61] [ g_kind = 'assign' g_text = '=' = 0 ]
        if [c eq 46] [ g_kind = 'dot' g_text = '.' = 0 ]
        = fail 'unexpected character'
    ]
    g_kind = 'eof'
    g_text = ''
    = 0
]

fn reset [str source] int [
    g_src = source
    g_pos = 0
    g_line = 1
    g_kind = 'eof'
    g_text = ''
    = next_tok 0
]

fn skip_nl [int unused] int [
    while [str.eq g_kind, 'nl'] [ next_tok 0 ]
    = 0
]

fn expect_kind [str kind] int [
    if [not str.eq g_kind, kind] [ = fail 'unexpected token kind' ]
    next_tok 0
    = 1
]

fn expect_id [str text] int [
    if [not str.eq g_kind, 'id'] [ = fail 'expected identifier' ]
    if [not str.eq g_text, text] [ = fail 'unexpected identifier' ]
    next_tok 0
    = 1
]

fn map_put [str table, str key, str value] str [
    str r = str.concat table, key
    r = str.concat r, '='
    r = str.concat r, value
    r = str.concat r, str.chr 10
    = r
]

fn map_get [str table, str key] str [
    int n = str.len table
    int i = 0
    str found = ''
    while [i lt n] [
        int ks = i
        while [i lt n and str.at table, i ne 61 and str.at table, i ne 10] [ i = i add 1 ]
        if [i ge n] [ break ]
        if [str.at table, i eq 10] [
            i = i add 1
            continue
        ]
        str k = str.slice table, ks, i
        i = i add 1
        int vs = i
        while [i lt n and str.at table, i ne 10] [ i = i add 1 ]
        str v = str.slice table, vs, i
        if [str.eq k, key] [ found = v ]
        if [i lt n] [ i = i add 1 ]
    ]
    = found
]

fn fn_param_key [str name, int index] str [
    str r = str.concat name, '@'
    = str.concat r, int.str index
]

fn parse_type [int unused] str [
    str t = g_text
    next_tok 0
    if [str.eq t, 'ptr'] [
        str elem = g_text
        next_tok 0
        t = str.concat 'ptr ', elem
    ]
    = t
]

fn is_decl_type [str s] int [
    if [str.eq s, 'int'] [ = 1 ]
    if [str.eq s, 'float'] [ = 1 ]
    if [str.eq s, 'str'] [ = 1 ]
    if [str.eq s, 'bool'] [ = 1 ]
    if [str.eq s, 'char'] [ = 1 ]
    if [str.eq s, 'ptr'] [ = 1 ]
    = 0
]

fn llvm_type [str t] str [
    if [str.eq t, 'int'] [ = 'i32' ]
    if [str.eq t, 'char'] [ = 'i32' ]
    if [str.eq t, 'bool'] [ = 'i1' ]
    if [str.eq t, 'float'] [ = 'double' ]
    if [str.eq t, 'str'] [ = 'ptr' ]
    if [str.starts t, 'ptr '] [ = 'ptr' ]
    = t
]

fn default_value [str t] str [
    if [str.eq t, 'str'] [ = 'null' ]
    if [str.starts t, 'ptr '] [ = 'null' ]
    if [str.eq t, 'float'] [ = '0.0' ]
    = '0'
]

fn local_type [str name] str [
    str t = map_get g_locals, name
    if [not str.eq t, ''] [ = t ]
    = map_get g_globals, name
]

fn local_addr [str name] str [
    str a = map_get g_local_addrs, name
    if [not str.eq a, ''] [ = a ]
    = str.concat '@', name
]

fn emit_line [str s] int [
    g_out = str.concat g_out, s
    g_out = str.concat g_out, str.chr 10
    = 0
]

fn emit_string_line [str s] int [
    g_strings = str.concat g_strings, s
    g_strings = str.concat g_strings, str.chr 10
    = 0
]

fn new_reg [int unused] str [
    g_temp = g_temp add 1
    = str.concat '%r', int.str g_temp
]

fn new_label [str prefix] str [
    g_label = g_label add 1
    str r = str.concat prefix, '.'
    = str.concat r, int.str g_label
]

fn emit_label [str name] int [
    emit_line str.concat name, ':'
    g_terminated = 0
    = 0
]

fn ensure_live [int unused] int [
    if [g_terminated] [
        str dead = new_label 'dead'
        emit_label dead
    ]
    = 0
]

fn emit_inst [str s] int [
    ensure_live 0
    emit_line str.concat '  ', s
    = 0
]

fn emit_branch [str label] int [
    emit_line str.concat '  br label %', label
    g_terminated = 1
    = 0
]

fn emit_cbranch [str cond, str yes, str no] int [
    str s = str.concat '  br i1 ', cond
    s = str.concat s, ', label %'
    s = str.concat s, yes
    s = str.concat s, ', label %'
    s = str.concat s, no
    emit_line s
    g_terminated = 1
    = 0
]

fn emit_return [str typ, str op] int [
    str s = str.concat '  ret ', llvm_type typ
    s = str.concat s, ' '
    s = str.concat s, op
    emit_line s
    g_terminated = 1
    = 0
]

fn emit_unreachable [int unused] int [
    emit_line '  unreachable'
    g_terminated = 1
    = 0
]

fn hex_digit [int n] str [
    if [n lt 10] [
        int code = n add 48
        = str.chr code
    ]
    int code2 = n sub 10 add 65
    = str.chr code2
]

fn hex_byte [int c] str [
    int hi = c div 16
    int lo = c mod 16
    str r = str.chr 92
    str hd = hex_digit hi
    r = str.concat r, hd
    str ld = hex_digit lo
    = str.concat r, ld
]

fn string_const [str s] str [
    int id = g_string_id
    g_string_id = g_string_id add 1
    str name = str.concat '@.str.', int.str id
    int n = str.len s
    int i = 0
    str data = ''
    while [i lt n] [
        int chv = str.at s, i
        str hb = hex_byte chv
        data = str.concat data, hb
        i = i add 1
    ]
    str slash = str.chr 92
    data = str.concat data, slash
    data = str.concat data, '00'
    int size = n add 1
    str q = str.chr 34
    str d = str.concat name, ' = private unnamed_addr constant ['