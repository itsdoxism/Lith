# Struct metadata for the self-hosted LLVM compiler.
str g_struct_counts = ''
str g_struct_indices = ''
str g_struct_types = ''

fn struct_key [str name, str field] str [
    str r = str.concat name, '@'
    = str.concat r, field
]

fn is_struct_type [str typ] int [
    str count = map_get g_struct_counts, typ
    if [str.eq count, ''] [ = 0 ]
    = 1
]

fn storage_type [str typ] str [
    if [is_struct_type typ] [
        = str.concat '%struct.', typ
    ]
    = llvm_type typ
]

fn struct_field_index [str name, str field] str [
    str key = struct_key name, field
    = map_get g_struct_indices, key
]

fn struct_field_type [str name, str field] str [
    str key = struct_key name, field
    = map_get g_struct_types, key
]
