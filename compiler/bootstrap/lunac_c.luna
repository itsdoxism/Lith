# Luna self-hosting compiler, bootstrap subset
use io
use str
use int

str g_src = ''
int g_pos = 0
int g_line = 1
str g_kind = 'eof'
str g_text = ''
str g_out = ''
int g_error = 0

fn is_alpha [int c] int [
    = c ge 65 and c le 90 or c ge 97 and c le 122 or c eq 95
]

fn is_digit [int c] int [
    = c ge 48 and c le 57
]

fn append_char [str s, int c] str [
    = str.concat s, str.chr c
]

fn emit [str s] int [
    g_out = str.concat g_out, s
    g_out = str.concat g_out, str.chr 10
    = 0
]

fn fail [str msg] int [
    g_error = 1
    = 0
]

fn next_tok [int unused] int [
    int n = str.len g_src
    while [g_pos lt n] [
        int c = str.at g_src, g_pos
        if [c eq 32 or c eq 9 or c eq 13] [
            g_pos = g_pos add 1
            continue
        ]
        if [c eq 35] [
            while [g_pos lt n and str.at g_src, g_pos ne 10] [
                g_pos = g_pos add 1
            ]
            continue
        ]
        if [c eq 10] [
            g_pos = g_pos add 1
            g_line = g_line add 1
            g_kind = 'nl'
            g_text = ''
            = 0
        ]
        if [c eq 39] [
            g_pos = g_pos add 1
            str s = ''
            while [g_pos lt n] [
                int q = str.at g_src, g_pos
                if [q eq 39] [
                    g_pos = g_pos add 1
                    g_kind = 'str'
                    g_text = s
                    = 0
                ]
                if [q eq 92] [
                    g_pos = g_pos add 1
                    if [g_pos ge n] [
                        = fail 'unterminated escape'
                    ]
                    int e = str.at g_src, g_pos
                    if [e eq 110] [ s = append_char s, 10 ]
                    else [
                        if [e eq 114] [ s = append_char s, 13 ]
                        else [
                            if [e eq 116] [ s = append_char s, 9 ]
                            else [ s = append_char s, e ]
                        ]
                    ]
                    g_pos = g_pos add 1
                    continue
                ]
                s = append_char s, q
                g_pos = g_pos add 1
            ]
            = fail 'unterminated string'
        ]
        if [is_alpha c] [
            int start = g_pos
            g_pos = g_pos add 1
            while [g_pos lt n] [
                int a = str.at g_src, g_pos
                if [not is_alpha a and not is_digit a] [ break ]
                g_pos = g_pos add 1
            ]
            g_kind = 'id'
            g_text = str.slice g_src, start, g_pos
            = 0
        ]
        if [is_digit c] [
            int startn = g_pos
            g_pos = g_pos add 1
            while [g_pos lt n and is_digit str.at g_src, g_pos] [
                g_pos = g_pos add 1
            ]
            g_kind = 'int'
            if [g_pos lt n and str.at g_src, g_pos eq 46] [
                g_pos = g_pos add 1
                while [g_pos lt n and is_digit str.at g_src, g_pos] [
                    g_pos = g_pos add 1
                ]
                g_kind = 'float'
            ]
            g_text = str.slice g_src, startn, g_pos
            = 0
        ]
        g_pos = g_pos add 1
        if [c eq 91] [
            g_kind = 'lb'
            g_text = '['
            = 0
        ]
        if [c eq 93] [
            g_kind = 'rb'
            g_text = ']'
            = 0
        ]
        if [c eq 44] [
            g_kind = 'comma'
            g_text = ','
            = 0
        ]
        if [c eq 61] [
            g_kind = 'assign'
            g_text = '='
            = 0
        ]
        if [c eq 46] [
            g_kind = 'dot'
            g_text = '.'
            = 0
        ]
        = fail 'unexpected character'
    ]
    g_kind = 'eof'
    g_text = ''
    = 0
]

fn reset [str source] int [
    g_src = source
    g_pos = 0
    g_line = 1
    g_kind = 'eof'
    g_text = ''
    = next_tok 0
]

fn skip_nl [int unused] int [
    while [str.eq g_kind, 'nl'] [
        next_tok 0
    ]
    = 0
]

fn expect_kind [str kind] int [
    if [not str.eq g_kind, kind] [
        = fail 'unexpected token kind'
    ]
    next_tok 0
    = 1
]

fn expect_id [str text] int [
    if [not str.eq g_kind, 'id'] [ = fail 'expected identifier' ]
    if [not str.eq g_text, text] [ = fail 'unexpected identifier' ]
    next_tok 0
    = 1
]

fn is_decl_type [str s] int [
    if [str.eq s, 'int'] [ = 1 ]
    if [str.eq s, 'float'] [ = 1 ]
    if [str.eq s, 'str'] [ = 1 ]
    if [str.eq s, 'bool'] [ = 1 ]
    if [str.eq s, 'char'] [ = 1 ]
    if [str.eq s, 'ptr'] [ = 1 ]
    = 0
]

fn ctype [str t] str [
    if [str.eq t, 'int'] [ = 'int' ]
    if [str.eq t, 'float'] [ = 'double' ]
    if [str.eq t, 'str'] [ = 'const char *' ]
    if [str.eq t, 'bool'] [ = 'bool' ]
    if [str.eq t, 'char'] [ = 'int' ]
    if [str.starts t, 'ptr '] [
        str elem = str.slice t, 4, str.len t
        str ct = ctype elem
        = str.concat ct, ' *'
    ]
    = t
]

fn parse_type [int unused] str [
    str t = g_text
    next_tok 0
    if [str.eq t, 'ptr'] [
        str elem = g_text
        next_tok 0
        t = str.concat 'ptr ', elem
    ]
    = t
]

fn precedence [str op] int [
    if [str.eq op, 'or'] [ = 1 ]
    if [str.eq op, 'and'] [ = 2 ]
    if [str.eq op, 'eq'] [ = 3 ]
    if [str.eq op, 'ne'] [ = 3 ]
    if [str.eq op, 'gt'] [ = 3 ]
    if [str.eq op, 'lt'] [ = 3 ]
    if [str.eq op, 'ge'] [ = 3 ]
    if [str.eq op, 'le'] [ = 3 ]
    if [str.eq op, 'add'] [ = 4 ]
    if [str.eq op, 'sub'] [ = 4 ]
    if [str.eq op, 'mul'] [ = 5 ]
    if [str.eq op, 'div'] [ = 5 ]
    if [str.eq op, 'mod'] [ = 5 ]
    = 0
]

fn cop [str op] str [
    if [str.eq op, 'or'] [ = '||' ]
    if [str.eq op, 'and'] [ = '&&' ]
    if [str.eq op, 'eq'] [ = '==' ]
    if [str.eq op, 'ne'] [ = '!=' ]
    if [str.eq op, 'gt'] [ = '>' ]
    if [str.eq op, 'lt'] [ = '<' ]
    if [str.eq op, 'ge'] [ = '>=' ]
    if [str.eq op, 'le'] [ = '<=' ]
    if [str.eq op, 'add'] [ = '+' ]
    if [str.eq op, 'sub'] [ = '-' ]
    if [str.eq op, 'mul'] [ = '*' ]
    if [str.eq op, 'div'] [ = '/' ]
    if [str.eq op, 'mod'] [ = '%' ]
    = op
]

fn mapped_name [str name] str [
    if [str.eq name, 'io.read_text'] [ = 'luna_read_text' ]
    if [str.eq name, 'io.write_text'] [ = 'luna_write_text' ]
    if [str.eq name, 'str.len'] [ = 'luna_str_len' ]
    if [str.eq name, 'str.at'] [ = 'luna_str_at' ]
    if [str.eq name, 'str.slice'] [ = 'luna_str_slice' ]
    if [str.eq name, 'str.concat'] [ = 'luna_str_concat' ]
    if [str.eq name, 'str.eq'] [ = 'luna_str_eq' ]
    if [str.eq name, 'str.starts'] [ = 'luna_str_starts' ]
    if [str.eq name, 'str.trim'] [ = 'luna_str_trim' ]
    if [str.eq name, 'str.chr'] [ = 'luna_str_chr' ]
    if [str.eq name, 'int.str'] [ = 'luna_int_str' ]
    = name
]

fn quote_c [str s] str [
    str q = str.chr 34
    str r = q
    int i = 0
    int n = str.len s
    while [i lt n] [
        int c = str.at s, i
        if [c eq 34 or c eq 92] [ r = append_char r, 92 ]
        if [c eq 10] [
            r = append_char r, 92
            r = append_char r, 110
        ]
        else [
            if [c eq 13] [
                r = append_char r, 92
                r = append_char r, 114
            ]
            else [
                if [c eq 9] [
                    r = append_char r, 92
                    r = append_char r, 116
                ]
                else [ r = append_char r, c ]
            ]
        ]
        i = i add 1
    ]
    = str.concat r, q
]

fn starts_expr [int unused] int [
    if [str.eq g_kind, 'int'] [ = 1 ]
    if [str.eq g_kind, 'float'] [ = 1 ]
    if [str.eq g_kind, 'str'] [ = 1 ]
    if [str.eq g_kind, 'id'] [ = 1 ]
    = 0
]

fn parse_expr [int minp] str [
    str left = parse_primary 0
    while [str.eq g_kind, 'id' and precedence g_text ge minp and precedence g_text gt 0] [
        str op = g_text
        int p = precedence op
        next_tok 0
        int nextp = p add 1
        str right = parse_expr nextp
        left = str.concat '(', left
        left = str.concat left, ' '
        left = str.concat left, cop op
        left = str.concat left, ' '
        left = str.concat left, right
        left = str.concat left, ')'
    ]
    = left
]

fn parse_primary [int unused] str [
    if [str.eq g_kind, 'int' or str.eq g_kind, 'float'] [
        str v = g_text
        next_tok 0
        = v
    ]
    if [str.eq g_kind, 'str'] [
        str s = quote_c g_text
        next_tok 0
        = s
    ]
    if [str.eq g_kind, 'id' and str.eq g_text, 'true'] [
        next_tok 0
        = 'true'
    ]
    if [str.eq g_kind, 'id' and str.eq g_text, 'false'] [
        next_tok 0
        = 'false'
    ]
    if [str.eq g_kind, 'id' and str.eq g_text, 'not'] [
        next_tok 0
        str x = parse_primary 0
        str r = str.concat '(!', x
        = str.concat r, ')'
    ]
    if [str.eq g_kind, 'id'] [
        str name = g_text
        next_tok 0
        while [str.eq g_kind, 'dot'] [
            next_tok 0
            name = str.concat name, '.'
            name = str.concat name, g_text
            next_tok 0
        ]
        str base = name
        while [str.eq g_kind, 'lb'] [
            next_tok 0
            str idx = parse_expr 0
            expect_kind 'rb'
            base = str.concat base, '['
            base = str.concat base, idx
            base = str.concat base, ']'
        ]
        if [starts_expr 0 and not precedence g_text gt 0] [
            str args = ''
            int first = 1
            while [starts_expr 0] [
                str a = parse_expr 6
                if [first eq 0] [ args = str.concat args, ', ' ]
                args = str.concat args, a
                first = 0
                if [str.eq g_kind, 'comma'] [ next_tok 0 ]
                else [ break ]
            ]
            str mapped = mapped_name name
            str call = str.concat mapped, '('
            call = str.concat call, args
            = str.concat call, ')'
        ]
        = base
    ]
    fail 'expected expression'
    = '0'
]

fn parse_decl_line [int emit_it] int [
    str t = parse_type 0
    str name = g_text
    next_tok 0
    expect_kind 'assign'
    str value = parse_expr 0
    if [emit_it] [
        str ct = ctype t
        str s = str.concat ct, ' '
        s = str.concat s, name
        s = str.concat s, ' = '
        s = str.concat s, value
        s = str.concat s, ';'
        emit s
    ]
    = 0
]

fn parse_stmt [int unused] int [
    skip_nl 0
    if [str.eq g_kind, 'id' and str.eq g_text, 'if'] [
        next_tok 0
        expect_kind 'lb'
        str cond = parse_expr 0
        expect_kind 'rb'
        emit str.concat 'if (', str.concat cond, ') {'
        parse_block 0
        emit '}'
        skip_nl 0
        if [str.eq g_kind, 'id' and str.eq g_text, 'else'] [
            next_tok 0
            emit 'else {'
            parse_block 0
            emit '}'
        ]
        = 0
    ]
    if [str.eq g_kind, 'id' and str.eq g_text, 'while'] [
        next_tok 0
        expect_kind 'lb'
        str condw = parse_expr 0
        expect_kind 'rb'
        emit str.concat 'while (', str.concat condw, ') {'
        parse_block 0
        emit '}'
        = 0
    ]
    if [str.eq g_kind, 'id' and str.eq g_text, 'break'] [
        next_tok 0
        emit 'break;'
        = 0
    ]
    if [str.eq g_kind, 'id' and str.eq g_text, 'continue'] [
        next_tok 0
        emit 'continue;'
        = 0
    ]
    if [str.eq g_kind, 'assign'] [
        next_tok 0
        str rv = parse_expr 0
        emit str.concat 'return ', str.concat rv, ';'
        = 0
    ]
    if [str.eq g_kind, 'id' and str.eq g_text, 'return'] [
        next_tok 0
        str rv2 = parse_expr 0
        emit str.concat 'return ', str.concat rv2, ';'
        = 0
    ]
    if [str.eq g_kind, 'id' and is_decl_type g_text] [
        = parse_decl_line 1
    ]
    str lhs = parse_expr 0
    if [str.eq g_kind, 'assign'] [
        next_tok 0
        str rhs = parse_expr 0
        str asn = str.concat lhs, ' = '
        asn = str.concat asn, rhs
        emit str.concat asn, ';'
        = 0
    ]
    emit str.concat lhs, ';'
    = 0
]

fn parse_block [int unused] int [
    expect_kind 'lb'
    skip_nl 0
    while [not str.eq g_kind, 'rb' and not str.eq g_kind, 'eof'] [
        parse_stmt 0
        skip_nl 0
    ]
    expect_kind 'rb'
    = 0
]

fn skip_block [int unused] int [
    expect_kind 'lb'
    int depth = 1
    while [depth gt 0 and not str.eq g_kind, 'eof'] [
        if [str.eq g_kind, 'lb'] [ depth = depth add 1 ]
        if [str.eq g_kind, 'rb'] [ depth = depth sub 1 ]
        next_tok 0
    ]
    = 0
]

fn parse_signature [int define_it] int [
    expect_id 'fn'
    str name = g_text
    next_tok 0
    expect_kind 'lb'
    str params = ''
    str silence = ''
    int first = 1
    while [not str.eq g_kind, 'rb'] [
        str t = parse_type 0
        str n = g_text
        next_tok 0
        if [first eq 0] [ params = str.concat params, ', ' ]
        params = str.concat params, ctype t
        params = str.concat params, ' '
        params = str.concat params, n
        silence = str.concat silence, '(void)'
        silence = str.concat silence, n
        silence = str.concat silence, '; '
        first = 0
        if [str.eq g_kind, 'comma'] [ next_tok 0 ]
        else [ break ]
    ]
    expect_kind 'rb'
    str ret = 'int'
    if [str.eq g_kind, 'id'] [
        ret = g_text
        next_tok 0
    ]
    str crt = ctype ret
    str head = str.concat crt, ' '
    head = str.concat head, name
    head = str.concat head, '('
    if [first] [ head = str.concat head, 'void' ]
    else [ head = str.concat head, params ]
    head = str.concat head, ')'
    if [define_it] [
        emit str.concat head, ' {'
        if [first eq 0] [ emit silence ]
        parse_block 0
        emit '}'
    ]
    else [
        emit str.concat head, ';'
        skip_block 0
    ]
    = 0
]

fn first_pass [str source] int [
    reset source
    emit '#include <stdbool.h>'
    emit '#include <stddef.h>'
    emit '#include <stdio.h>'
    emit '#include <stdlib.h>'
    emit '#include <string.h>'
    emit '#include "luna_runtime.h"'
    emit ''
    skip_nl 0
    while [not str.eq g_kind, 'eof'] [
        if [str.eq g_kind, 'id' and str.eq g_text, 'use'] [
            next_tok 0
            next_tok 0
        ]
        else [
            if [str.eq g_kind, 'id' and str.eq g_text, 'fn'] [
                parse_signature 0
            ]
            else [
                if [str.eq g_kind, 'id' and is_decl_type g_text] [ parse_decl_line 1 ]
                else [
                    fail 'unsupported top level item'
                    = 0
                ]
            ]
        ]
        skip_nl 0
    ]
    emit ''
    = 0
]

fn second_pass [str source] int [
    reset source
    skip_nl 0
    while [not str.eq g_kind, 'eof'] [
        if [str.eq g_kind, 'id' and str.eq g_text, 'use'] [
            next_tok 0
            next_tok 0
        ]
        else [
            if [str.eq g_kind, 'id' and str.eq g_text, 'fn'] [
                parse_signature 1
                emit ''
            ]
            else [
                if [str.eq g_kind, 'id' and is_decl_type g_text] [ parse_decl_line 0 ]
                else [
                    fail 'unsupported top level item'
                    = 0
                ]
            ]
        ]
        skip_nl 0
    ]
    = 0
]

fn compile [str source] str [
    g_out = ''
    g_error = 0
    first_pass source
    second_pass source
    = g_out
]

fn main [int argc, ptr str argv] int [
    if [argc lt 3] [ = 2 ]
    str source = io.read_text argv[1]
    str c = compile source
    if [g_error] [ = 1 ]
    int ok = io.write_text argv[2], c
    if [ok eq 0] [ = 1 ]
    = 0
]
