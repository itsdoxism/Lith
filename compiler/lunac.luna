# Struct metadata for the self-hosted LLVM compiler.
str g_struct_counts = ''
str g_struct_indices = ''
str g_struct_types = ''

fn struct_key [str name, str field] str [
    str r = str.concat name, '@'
    = str.concat r, field
]

fn is_struct_type [str typ] int [
    str count = map_get g_struct_counts, typ
    if [str.eq count, ''] [ = 0 ]
    = 1
]

fn storage_type [str typ] str [
    if [is_struct_type typ] [
        = str.concat '%struct.', typ
    ]
    = llvm_type typ
]

fn struct_field_index [str name, str field] str [
    str key = struct_key name, field
    = map_get g_struct_indices, key
]

fn struct_field_type [str name, str field] str [
    str key = struct_key name, field
    = map_get g_struct_types, key
]
# Luna LLVM compiler bootstrap subset, written in Luna.
# This compiler emits typed LLVM IR directly for the subset needed to compile itself.
use io
use str
use int

str g_src = ''
int g_pos = 0
int g_line = 1
str g_kind = 'eof'
str g_text = ''
int g_error = 0

str g_out = ''
str g_strings = ''
int g_string_id = 0
int g_temp = 0
int g_label = 0
int g_terminated = 0
str g_break_label = ''
str g_continue_label = ''
str g_current_ret = 'int'

str g_globals = ''
str g_locals = ''
str g_local_addrs = ''
str g_fn_ret = ''
str g_fn_argc = ''
str g_fn_params = ''

str g_expr_type = 'int'
str g_expr_addr = ''

fn append_char [str s, int c] str [
    = str.concat s, str.chr c
]

fn fail [str msg] int [
    g_error = 1
    = 0
]

fn is_alpha [int c] int [
    = c ge 65 and c le 90 or c ge 97 and c le 122 or c eq 95
]

fn is_digit [int c] int [
    = c ge 48 and c le 57
]

fn next_tok [int unused] int [
    int n = str.len g_src
    while [g_pos lt n] [
        int c = str.at g_src, g_pos
        if [c eq 32 or c eq 9 or c eq 13] [
            g_pos = g_pos add 1
            continue
        ]
        if [c eq 35] [
            while [g_pos lt n and str.at g_src, g_pos ne 10] [
                g_pos = g_pos add 1
            ]
            continue
        ]
        if [c eq 10] [
            g_pos = g_pos add 1
            g_line = g_line add 1
            g_kind = 'nl'
            g_text = ''
            = 0
        ]
        if [c eq 39] [
            g_pos = g_pos add 1
            str s = ''
            while [g_pos lt n] [
                int q = str.at g_src, g_pos
                if [q eq 39] [
                    g_pos = g_pos add 1
                    g_kind = 'str'
                    g_text = s
                    = 0
                ]
                if [q eq 92] [
                    g_pos = g_pos add 1
                    if [g_pos ge n] [ = fail 'unterminated escape' ]
                    int e = str.at g_src, g_pos
                    if [e eq 110] [ s = append_char s, 10 ]
                    else [
                        if [e eq 114] [ s = append_char s, 13 ]
                        else [
                            if [e eq 116] [ s = append_char s, 9 ]
                            else [ s = append_char s, e ]
                        ]
                    ]
                    g_pos = g_pos add 1
                    continue
                ]
                s = append_char s, q
                g_pos = g_pos add 1
            ]
            = fail 'unterminated string'
        ]
        if [is_alpha c] [
            int start = g_pos
            g_pos = g_pos add 1
            while [g_pos lt n] [
                int a = str.at g_src, g_pos
                if [not is_alpha a and not is_digit a] [ break ]
                g_pos = g_pos add 1
            ]
            g_kind = 'id'
            g_text = str.slice g_src, start, g_pos
            = 0
        ]
        if [is_digit c] [
            int startn = g_pos
            g_pos = g_pos add 1
            while [g_pos lt n and is_digit str.at g_src, g_pos] [
                g_pos = g_pos add 1
            ]
            g_kind = 'int'
            if [g_pos lt n and str.at g_src, g_pos eq 46] [
                g_pos = g_pos add 1
                while [g_pos lt n and is_digit str.at g_src, g_pos] [
                    g_pos = g_pos add 1
                ]
                g_kind = 'float'
            ]
            g_text = str.slice g_src, startn, g_pos
            = 0
        ]
        g_pos = g_pos add 1
        if [c eq 91] [ g_kind = 'lb' g_text = '[' = 0 ]
        if [c eq 93] [ g_kind = 'rb' g_text = ']' = 0 ]
        if [c eq 44] [ g_kind = 'comma' g_text = ',' = 0 ]
        if [c eq 61] [ g_kind = 'assign' g_text = '=' = 0 ]
        if [c eq 46] [ g_kind = 'dot' g_text = '.' = 0 ]
        = fail 'unexpected character'
    ]
    g_kind = 'eof'
    g_text = ''
    = 0
]

fn reset [str source] int [
    g_src = source
    g_pos = 0
    g_line = 1
    g_kind = 'eof'
    g_text = ''
    = next_tok 0
]

fn skip_nl [int unused] int [
    while [str.eq g_kind, 'nl'] [ next_tok 0 ]
    = 0
]

fn expect_kind [str kind] int [
    if [not str.eq g_kind, kind] [ = fail 'unexpected token kind' ]
    next_tok 0
    = 1
]

fn expect_id [str text] int [
    if [not str.eq g_kind, 'id'] [ = fail 'expected identifier' ]
    if [not str.eq g_text, text] [ = fail 'unexpected identifier' ]
    next_tok 0
    = 1
]

fn map_put [str table, str key, str value] str [
    str r = str.concat table, key
    r = str.concat r, '='
    r = str.concat r, value
    r = str.concat r, str.chr 10
    = r
]

fn map_get [str table, str key] str [
    int n = str.len table
    int i = 0
    str found = ''
    while [i lt n] [
        int ks = i
        while [i lt n and str.at table, i ne 61 and str.at table, i ne 10] [ i = i add 1 ]
        if [i ge n] [ break ]
        if [str.at table, i eq 10] [
            i = i add 1
            continue
        ]
        str k = str.slice table, ks, i
        i = i add 1
        int vs = i
        while [i lt n and str.at table, i ne 10] [ i = i add 1 ]
        str v = str.slice table, vs, i
        if [str.eq k, key] [ found = v ]
        if [i lt n] [ i = i add 1 ]
    ]
    = found
]

fn fn_param_key [str name, int index] str [
    str r = str.concat name, '@'
    = str.concat r, int.str index
]

fn parse_type [int unused] str [
    str t = g_text
    next_tok 0
    if [str.eq t, 'ptr'] [
        str elem = g_text
        next_tok 0
        t = str.concat 'ptr ', elem
    ]
    = t
]

fn is_decl_type [str s] int [
    if [str.eq s, 'int'] [ = 1 ]
    if [str.eq s, 'float'] [ = 1 ]
    if [str.eq s, 'str'] [ = 1 ]
    if [str.eq s, 'bool'] [ = 1 ]
    if [str.eq s, 'char'] [ = 1 ]
    if [str.eq s, 'ptr'] [ = 1 ]
    = 0
]

fn llvm_type [str t] str [
    if [str.eq t, 'int'] [ = 'i32' ]
    if [str.eq t, 'char'] [ = 'i32' ]
    if [str.eq t, 'bool'] [ = 'i1' ]
    if [str.eq t, 'float'] [ = 'double' ]
    if [str.eq t, 'str'] [ = 'ptr' ]
    if [str.starts t, 'ptr '] [ = 'ptr' ]
    = t
]

fn default_value [str t] str [
    if [str.eq t, 'str'] [ = 'null' ]
    if [str.starts t, 'ptr '] [ = 'null' ]
    if [str.eq t, 'float'] [ = '0.0' ]
    = '0'
]

fn local_type [str name] str [
    str t = map_get g_locals, name
    if [not str.eq t, ''] [ = t ]
    = map_get g_globals, name
]

fn local_addr [str name] str [
    str a = map_get g_local_addrs, name
    if [not str.eq a, ''] [ = a ]
    = str.concat '@', name
]

fn emit_line [str s] int [
    g_out = str.concat g_out, s
    g_out = str.concat g_out, str.chr 10
    = 0
]

fn emit_string_line [str s] int [
    g_strings = str.concat g_strings, s
    g_strings = str.concat g_strings, str.chr 10
    = 0
]

fn new_reg [int unused] str [
    g_temp = g_temp add 1
    = str.concat '%r', int.str g_temp
]

fn new_label [str prefix] str [
    g_label = g_label add 1
    str r = str.concat prefix, '.'
    = str.concat r, int.str g_label
]

fn emit_label [str name] int [
    emit_line str.concat name, ':'
    g_terminated = 0
    = 0
]

fn ensure_live [int unused] int [
    if [g_terminated] [
        str dead = new_label 'dead'
        emit_label dead
    ]
    = 0
]

fn emit_inst [str s] int [
    ensure_live 0
    emit_line str.concat '  ', s
    = 0
]

fn emit_branch [str label] int [
    emit_line str.concat '  br label %', label
    g_terminated = 1
    = 0
]

fn emit_cbranch [str cond, str yes, str no] int [
    str s = str.concat '  br i1 ', cond
    s = str.concat s, ', label %'
    s = str.concat s, yes
    s = str.concat s, ', label %'
    s = str.concat s, no
    emit_line s
    g_terminated = 1
    = 0
]

fn emit_return [str typ, str op] int [
    str s = str.concat '  ret ', llvm_type typ
    s = str.concat s, ' '
    s = str.concat s, op
    emit_line s
    g_terminated = 1
    = 0
]

fn emit_unreachable [int unused] int [
    emit_line '  unreachable'
    g_terminated = 1
    = 0
]

fn hex_digit [int n] str [
    if [n lt 10] [
        int code = n add 48
        = str.chr code
    ]
    int code2 = n sub 10 add 65
    = str.chr code2
]

fn hex_byte [int c] str [
    int hi = c div 16
    int lo = c mod 16
    str r = str.chr 92
    str hd = hex_digit hi
    r = str.concat r, hd
    str ld = hex_digit lo
    = str.concat r, ld
]

fn string_const [str s] str [
    int id = g_string_id
    g_string_id = g_string_id add 1
    str name = str.concat '@.str.', int.str id
    int n = str.len s
    int i = 0
    str data = ''
    while [i lt n] [
        int chv = str.at s, i
        str hb = hex_byte chv
        data = str.concat data, hb
        i = i add 1
    ]
    str slash = str.chr 92
    data = str.concat data, slash
    data = str.concat data, '00'
    int size = n add 1
    str q = str.chr 34
    str d = str.concat name, ' = private unnamed_addr constant ['
    d = str.concat d, int.str size
    d = str.concat d, ' x i8] c'
    d = str.concat d, q
    d = str.concat d, data
    d = str.concat d, q
    d = str.concat d, ', align 1'
    emit_string_line d
    str r = str.concat 'getelementptr inbounds ([', int.str size
    r = str.concat r, ' x i8], ptr '
    r = str.concat r, name
    r = str.concat r, ', i64 0, i64 0)'
    = r
]

fn precedence [str op] int [
    if [str.eq op, 'or'] [ = 1 ]
    if [str.eq op, 'and'] [ = 2 ]
    if [str.eq op, 'eq'] [ = 3 ]
    if [str.eq op, 'ne'] [ = 3 ]
    if [str.eq op, 'gt'] [ = 3 ]
    if [str.eq op, 'lt'] [ = 3 ]
    if [str.eq op, 'ge'] [ = 3 ]
    if [str.eq op, 'le'] [ = 3 ]
    if [str.eq op, 'add'] [ = 4 ]
    if [str.eq op, 'sub'] [ = 4 ]
    if [str.eq op, 'mul'] [ = 5 ]
    if [str.eq op, 'div'] [ = 5 ]
    if [str.eq op, 'mod'] [ = 5 ]
    = 0
]

fn starts_expr [int unused] int [
    if [str.eq g_kind, 'int'] [ = 1 ]
    if [str.eq g_kind, 'float'] [ = 1 ]
    if [str.eq g_kind, 'str'] [ = 1 ]
    if [str.eq g_kind, 'id'] [ = 1 ]
    = 0
]

fn mapped_name [str name] str [
    if [str.eq name, 'io.read_text'] [ = 'luna_read_text' ]
    if [str.eq name, 'io.write_text'] [ = 'luna_write_text' ]
    if [str.eq name, 'str.len'] [ = 'luna_str_len' ]
    if [str.eq name, 'str.at'] [ = 'luna_str_at' ]
    if [str.eq name, 'str.slice'] [ = 'luna_str_slice' ]
    if [str.eq name, 'str.concat'] [ = 'luna_str_concat' ]
    if [str.eq name, 'str.eq'] [ = 'luna_str_eq' ]
    if [str.eq name, 'str.starts'] [ = 'luna_str_starts' ]
    if [str.eq name, 'str.trim'] [ = 'luna_str_trim' ]
    if [str.eq name, 'str.chr'] [ = 'luna_str_chr' ]
    if [str.eq name, 'int.str'] [ = 'luna_int_str' ]
    = name
]

fn builtin_ret [str name] str [
    if [str.eq name, 'io.read_text'] [ = 'str' ]
    if [str.eq name, 'io.write_text'] [ = 'int' ]
    if [str.eq name, 'str.len'] [ = 'int' ]
    if [str.eq name, 'str.at'] [ = 'int' ]
    if [str.eq name, 'str.slice'] [ = 'str' ]
    if [str.eq name, 'str.concat'] [ = 'str' ]
    if [str.eq name, 'str.eq'] [ = 'int' ]
    if [str.eq name, 'str.starts'] [ = 'int' ]
    if [str.eq name, 'str.trim'] [ = 'str' ]
    if [str.eq name, 'str.chr'] [ = 'str' ]
    if [str.eq name, 'int.str'] [ = 'str' ]
    = map_get g_fn_ret, name
]

fn builtin_argc [str name] int [
    if [str.eq name, 'io.read_text'] [ = 1 ]
    if [str.eq name, 'io.write_text'] [ = 2 ]
    if [str.eq name, 'str.len'] [ = 1 ]
    if [str.eq name, 'str.at'] [ = 2 ]
    if [str.eq name, 'str.slice'] [ = 3 ]
    if [str.eq name, 'str.concat'] [ = 2 ]
    if [str.eq name, 'str.eq'] [ = 2 ]
    if [str.eq name, 'str.starts'] [ = 2 ]
    if [str.eq name, 'str.trim'] [ = 1 ]
    if [str.eq name, 'str.chr'] [ = 1 ]
    if [str.eq name, 'int.str'] [ = 1 ]
    str n = map_get g_fn_argc, name
    if [str.eq n, ''] [ = 0 ]
    # Function calls in the bootstrap source never need this numeric value for user functions.
    = 0
]

fn builtin_param [str name, int index] str [
    if [str.eq name, 'io.read_text'] [ = 'str' ]
    if [str.eq name, 'io.write_text'] [ = 'str' ]
    if [str.eq name, 'str.len'] [ = 'str' ]
    if [str.eq name, 'str.at'] [
        if [index eq 0] [ = 'str' ]
        = 'int'
    ]
    if [str.eq name, 'str.slice'] [
        if [index eq 0] [ = 'str' ]
        = 'int'
    ]
    if [str.eq name, 'str.concat'] [ = 'str' ]
    if [str.eq name, 'str.eq'] [ = 'str' ]
    if [str.eq name, 'str.starts'] [ = 'str' ]
    if [str.eq name, 'str.trim'] [ = 'str' ]
    if [str.eq name, 'str.chr'] [ = 'int' ]
    if [str.eq name, 'int.str'] [ = 'int' ]
    str key = fn_param_key name, index
    = map_get g_fn_params, key
]

fn boolify [str op, str typ] str [
    if [str.eq typ, 'bool'] [ = op ]
    str r = new_reg 0
    if [str.eq typ, 'str' or str.starts typ, 'ptr '] [
        str s = str.concat r, ' = icmp ne ptr '
        s = str.concat s, op
        s = str.concat s, ', null'
        emit_inst s
        = r
    ]
    str s2 = str.concat r, ' = icmp ne i32 '
    s2 = str.concat s2, op
    s2 = str.concat s2, ', 0'
    emit_inst s2
    = r
]

fn intify [str op, str typ] str [
    if [str.eq typ, 'int' or str.eq typ, 'char'] [ = op ]
    if [str.eq typ, 'bool'] [
        str r = new_reg 0
        str s = str.concat r, ' = zext i1 '
        s = str.concat s, op
        s = str.concat s, ' to i32'
        emit_inst s
        = r
    ]
    = op
]

fn cast_value [str op, str from, str to] str [
    if [str.eq from, to] [ = op ]
    if [str.eq to, 'bool'] [ = boolify op, from ]
    if [str.eq to, 'int'] [ = intify op, from ]
    if [str.eq to, 'char'] [ = intify op, from ]
    if [str.eq to, 'str' and str.starts from, 'ptr '] [ = op ]
    if [str.starts to, 'ptr ' and str.eq from, 'str'] [ = op ]
    if [str.starts to, 'ptr ' and str.starts from, 'ptr '] [ = op ]
    = op
]

fn emit_binary [str op, str left, str lt, str right, str rt] str [
    if [str.eq op, 'and' or str.eq op, 'or'] [
        str a = boolify left, lt
        str b = boolify right, rt
        str r = new_reg 0
        str inst = 'and'
        if [str.eq op, 'or'] [ inst = 'or' ]
        str s = str.concat r, ' = '
        s = str.concat s, inst
        s = str.concat s, ' i1 '
        s = str.concat s, a
        s = str.concat s, ', '
        s = str.concat s, b
        emit_inst s
        g_expr_type = 'bool'
        g_expr_addr = ''
        = r
    ]
    if [str.eq op, 'eq' or str.eq op, 'ne' or str.eq op, 'gt' or str.eq op, 'lt' or str.eq op, 'ge' or str.eq op, 'le'] [
        str a = intify left, lt
        str b = intify right, rt
        str pred = 'eq'
        if [str.eq op, 'ne'] [ pred = 'ne' ]
        if [str.eq op, 'gt'] [ pred = 'sgt' ]
        if [str.eq op, 'lt'] [ pred = 'slt' ]
        if [str.eq op, 'ge'] [ pred = 'sge' ]
        if [str.eq op, 'le'] [ pred = 'sle' ]
        str r = new_reg 0
        str s = str.concat r, ' = icmp '
        s = str.concat s, pred
        s = str.concat s, ' i32 '
        s = str.concat s, a
        s = str.concat s, ', '
        s = str.concat s, b
        emit_inst s
        g_expr_type = 'bool'
        g_expr_addr = ''
        = r
    ]
    str a2 = intify left, lt
    str b2 = intify right, rt
    str inst2 = 'add'
    if [str.eq op, 'sub'] [ inst2 = 'sub' ]
    if [str.eq op, 'mul'] [ inst2 = 'mul' ]
    if [str.eq op, 'div'] [ inst2 = 'sdiv' ]
    if [str.eq op, 'mod'] [ inst2 = 'srem' ]
    str r2 = new_reg 0
    str s2 = str.concat r2, ' = '
    s2 = str.concat s2, inst2
    s2 = str.concat s2, ' i32 '
    s2 = str.concat s2, a2
    s2 = str.concat s2, ', '
    s2 = str.concat s2, b2
    emit_inst s2
    g_expr_type = 'int'
    g_expr_addr = ''
    = r2
]

fn parse_expr [int minp] str [
    str left = parse_primary 0
    str lt = g_expr_type
    str la = g_expr_addr
    while [str.eq g_kind, 'id' and precedence g_text ge minp and precedence g_text gt 0] [
        str op = g_text
        int p = precedence op
        next_tok 0
        int nextp = p add 1
        str right = parse_expr nextp
        str rt = g_expr_type
        left = emit_binary op, left, lt, right, rt
        lt = g_expr_type
        la = ''
    ]
    g_expr_type = lt
    g_expr_addr = la
    = left
]

fn emit_call [str name] str [
    str args = ''
    int index = 0
    int first = 1
    while [starts_expr 0] [
        str a = parse_expr 6
        str at = g_expr_type
        str pt = builtin_param name, index
        if [not str.eq pt, ''] [
            a = cast_value a, at, pt
            at = pt
        ]
        if [first eq 0] [ args = str.concat args, ', ' ]
        args = str.concat args, llvm_type at
        args = str.concat args, ' '
        args = str.concat args, a
        first = 0
        index = index add 1
        if [str.eq g_kind, 'comma'] [ next_tok 0 ]
        else [ break ]
    ]
    str ret = builtin_ret name
    str mapped = mapped_name name
    str r = new_reg 0
    str s = str.concat r, ' = call '
    s = str.concat s, llvm_type ret
    s = str.concat s, ' @'
    s = str.concat s, mapped
    s = str.concat s, '('
    s = str.concat s, args
    s = str.concat s, ')'
    emit_inst s
    g_expr_type = ret
    g_expr_addr = ''
    = r
]

fn parse_primary [int unused] str [
    if [str.eq g_kind, 'int'] [
        str v = g_text
        next_tok 0
        g_expr_type = 'int'
        g_expr_addr = ''
        = v
    ]
    if [str.eq g_kind, 'float'] [
        str v2 = g_text
        next_tok 0
        g_expr_type = 'float'
        g_expr_addr = ''
        = v2
    ]
    if [str.eq g_kind, 'str'] [
        str v3 = string_const g_text
        next_tok 0
        g_expr_type = 'str'
        g_expr_addr = ''
        = v3
    ]
    if [str.eq g_kind, 'id' and str.eq g_text, 'true'] [
        next_tok 0
        g_expr_type = 'bool'
        g_expr_addr = ''
        = '1'
    ]
    if [str.eq g_kind, 'id' and str.eq g_text, 'false'] [
        next_tok 0
        g_expr_type = 'bool'
        g_expr_addr = ''
        = '0'
    ]
    if [str.eq g_kind, 'id' and str.eq g_text, 'not'] [
        next_tok 0
        str x = parse_primary 0
        str xt = g_expr_type
        str b = boolify x, xt
        str rnot = new_reg 0
        str sn = str.concat rnot, ' = xor i1 '
        sn = str.concat sn, b
        sn = str.concat sn, ', true'
        emit_inst sn
        g_expr_type = 'bool'
        g_expr_addr = ''
        = rnot
    ]
    if [str.eq g_kind, 'id'] [
        str name = g_text
        next_tok 0
        while [str.eq g_kind, 'dot'] [
            next_tok 0
            name = str.concat name, '.'
            name = str.concat name, g_text
            next_tok 0
        ]
        if [starts_expr 0 and not precedence g_text gt 0] [
            = emit_call name
        ]
        str typ = local_type name
        if [str.eq typ, ''] [
            fail 'unknown variable'
            g_expr_type = 'int'
            g_expr_addr = ''
            = '0'
        ]
        str addr = local_addr name
        str r = new_reg 0
        str s = str.concat r, ' = load '
        s = str.concat s, llvm_type typ
        s = str.concat s, ', ptr '
        s = str.concat s, addr
        emit_inst s
        str value = r
        str current_type = typ
        str current_addr = addr
        while [str.eq g_kind, 'lb'] [
            next_tok 0
            str idx = parse_expr 0
            str it = g_expr_type
            idx = intify idx, it
            expect_kind 'rb'
            if [not str.starts current_type, 'ptr '] [
                fail 'indexing non pointer'
                = value
            ]
            str elem = str.slice current_type, 4, str.len current_type
            str gep = new_reg 0
            str gs = str.concat gep, ' = getelementptr inbounds '
            gs = str.concat gs, storage_type elem
            gs = str.concat gs, ', ptr '
            gs = str.concat gs, value
            gs = str.concat gs, ', i32 '
            gs = str.concat gs, idx
            emit_inst gs
            str loaded = new_reg 0
            str ls = str.concat loaded, ' = load '
            ls = str.concat ls, storage_type elem
            ls = str.concat ls, ', ptr '
            ls = str.concat ls, gep
            emit_inst ls
            value = loaded
            current_type = elem
            current_addr = gep
        ]
        while [str.eq g_kind, 'dot'] [
            next_tok 0
            if [not str.eq g_kind, 'id'] [
                fail 'expected struct field'
                = value
            ]
            str field = g_text
            next_tok 0
            if [not is_struct_type current_type] [
                fail 'member access on non struct'
                = value
            ]
            str field_index = struct_field_index current_type, field
            str field_type = struct_field_type current_type, field
            if [str.eq field_index, '' or str.eq field_type, ''] [
                fail 'unknown struct field'
                = value
            ]
            str field_addr = new_reg 0
            str fs = str.concat field_addr, ' = getelementptr inbounds '
            fs = str.concat fs, storage_type current_type
            fs = str.concat fs, ', ptr '
            fs = str.concat fs, current_addr
            fs = str.concat fs, ', i32 0, i32 '
            fs = str.concat fs, field_index
            emit_inst fs
            str field_value = new_reg 0
            str fl = str.concat field_value, ' = load '
            fl = str.concat fl, storage_type field_type
            fl = str.concat fl, ', ptr '
            fl = str.concat fl, field_addr
            emit_inst fl
            value = field_value
            current_type = field_type
            current_addr = field_addr
        ]
        g_expr_type = current_type
        g_expr_addr = current_addr
        = value
    ]
    fail 'expected expression'
    g_expr_type = 'int'
    g_expr_addr = ''
    = '0'
]

fn pointee_type [str typ] str [
    if [str.starts typ, 'ptr '] [
        = str.slice typ, 4, str.len typ
    ]
    = 'int'
]

fn emit_alloc_size [str target_type, str count] str [
    str elem = pointee_type target_type
    str sizeptr = new_reg 0
    str gs = str.concat sizeptr, ' = getelementptr '
    gs = str.concat gs, storage_type elem
    gs = str.concat gs, ', ptr null, i32 '
    gs = str.concat gs, count
    emit_inst gs
    str bytes = new_reg 0
    str ps = str.concat bytes, ' = ptrtoint ptr '
    ps = str.concat ps, sizeptr
    ps = str.concat ps, ' to i64'
    emit_inst ps
    = bytes
]

fn emit_sys_memory [str target_type] str [
    expect_id 'sys'
    expect_kind 'dot'
    str method = g_text
    next_tok 0

    if [str.eq method, 'alloc'] [
        str count = parse_expr 6
        str count_type = g_expr_type
        count = intify count, count_type
        str bytes = emit_alloc_size target_type, count
        str out = new_reg 0
        str call = str.concat out, ' = call ptr @malloc(i64 '
        call = str.concat call, bytes
        call = str.concat call, ')'
        emit_inst call
        g_expr_type = target_type
        g_expr_addr = ''
        = out
    ]

    if [str.eq method, 'realloc'] [
        str old = parse_expr 6
        str old_type = g_expr_type
        if [str.eq g_kind, 'comma'] [ next_tok 0 ]
        else [ fail 'sys.realloc expects pointer and count' ]
        str count2 = parse_expr 6
        str count_type2 = g_expr_type
        count2 = intify count2, count_type2
        str actual_type = target_type
        if [not str.starts actual_type, 'ptr '] [ actual_type = old_type ]
        str bytes2 = emit_alloc_size actual_type, count2
        str out2 = new_reg 0
        str call2 = str.concat out2, ' = call ptr @realloc(ptr '
        call2 = str.concat call2, old
        call2 = str.concat call2, ', i64 '
        call2 = str.concat call2, bytes2
        call2 = str.concat call2, ')'
        emit_inst call2
        g_expr_type = actual_type
        g_expr_addr = ''
        = out2
    ]

    if [str.eq method, 'free'] [
        str old2 = parse_expr 6
        str call3 = str.concat 'call void @free(ptr ', old2
        call3 = str.concat call3, ')'
        emit_inst call3
        g_expr_type = 'int'
        g_expr_addr = ''
        = '0'
    ]

    fail 'unknown sys memory operation'
    g_expr_type = target_type
    g_expr_addr = ''
    = '0'
]

fn parse_decl_ir [int unused] int [
    str typ = parse_type 0
    str name = g_text
    next_tok 0
    expect_kind 'assign'
    g_locals = map_put g_locals, name, typ
    str addr = new_reg 0
    g_local_addrs = map_put g_local_addrs, name, addr
    str a = str.concat addr, ' = alloca '
    emit_inst str.concat a, llvm_type typ
    str value = ''
    if [str.eq g_kind, 'id' and str.eq g_text, 'sys'] [
        value = emit_sys_memory typ
    ]
    else [
        value = parse_expr 0
    ]
    str vt = g_expr_type
    value = cast_value value, vt, typ
    str st = str.concat 'store ', llvm_type typ
    st = str.concat st, ' '
    st = str.concat st, value
    st = str.concat st, ', ptr '
    st = str.concat st, addr
    emit_inst st
    = 0
]


fn load_match_target [int unused] str [
    if [str.eq g_kind, 'int' or str.eq g_kind, 'str'] [
        = parse_primary 0
    ]
    if [str.eq g_kind, 'id'] [
        str name = g_text
        next_tok 0
        str typ = local_type name
        if [str.eq typ, ''] [
            fail 'unknown match target'
            g_expr_type = 'int'
            = '0'
        ]
        str addr = local_addr name
        str r = new_reg 0
        str s = str.concat r, ' = load '
        s = str.concat s, storage_type typ
        s = str.concat s, ', ptr '
        s = str.concat s, addr
        emit_inst s
        g_expr_type = typ
        g_expr_addr = addr
        = r
    ]
    fail 'unsupported match target'
    g_expr_type = 'int'
    = '0'
]

fn emit_match_return [str ret] int [
    expect_id 'match'
    str target = load_match_target 0
    str target_type = g_expr_type
    expect_kind 'lb'
    skip_nl 0

    while [str.eq g_kind, 'id' and str.eq g_text, 'is'] [
        next_tok 0
        str pat = parse_expr 0
        str pat_type = g_expr_type
        str case_label = new_label 'match.case'
        str next_label = new_label 'match.next'
        str cond = ''

        if [str.eq target_type, 'str' and str.eq pat_type, 'str'] [
            str eqv = new_reg 0
            str eqs = str.concat eqv, ' = call i32 @luna_str_eq(ptr '
            eqs = str.concat eqs, target
            eqs = str.concat eqs, ', ptr '
            eqs = str.concat eqs, pat
            eqs = str.concat eqs, ')'
            emit_inst eqs
            cond = new_reg 0
            str cs = str.concat cond, ' = icmp ne i32 '
            cs = str.concat cs, eqv
            cs = str.concat cs, ', 0'
            emit_inst cs
        ]
        else [
            str left = intify target, target_type
            str right = intify pat, pat_type
            cond = new_reg 0
            str cs2 = str.concat cond, ' = icmp eq i32 '
            cs2 = str.concat cs2, left
            cs2 = str.concat cs2, ', '
            cs2 = str.concat cs2, right
            emit_inst cs2
        ]

        emit_cbranch cond, case_label, next_label
        emit_label case_label
        expect_kind 'lb'
        skip_nl 0
        str value = parse_expr 0
        str value_type = g_expr_type
        value = cast_value value, value_type, ret
        skip_nl 0
        expect_kind 'rb'
        emit_return ret, value
        emit_label next_label
        skip_nl 0
    ]

    expect_id 'else'
    expect_kind 'lb'
    skip_nl 0
    str fallback = parse_expr 0
    str fallback_type = g_expr_type
    fallback = cast_value fallback, fallback_type, ret
    skip_nl 0
    expect_kind 'rb'
    emit_return ret, fallback
    skip_nl 0
    expect_kind 'rb'
    = 0
]

fn append_print_value [str acc, str value] str [
    str r = new_reg 0
    str s = str.concat r, ' = call ptr @luna_str_concat(ptr '
    s = str.concat s, acc
    s = str.concat s, ', ptr '
    s = str.concat s, value
    s = str.concat s, ')'
    emit_inst s
    = r
]

fn print_value_for_name [str name] str [
    str typ = local_type name
    if [str.eq typ, ''] [
        fail 'unknown io.print interpolation name'
        = string_const ''
    ]
    str addr = local_addr name
    str loaded = new_reg 0
    str ls = str.concat loaded, ' = load '
    ls = str.concat ls, storage_type typ
    ls = str.concat ls, ', ptr '
    ls = str.concat ls, addr
    emit_inst ls

    if [str.eq typ, 'str'] [ = loaded ]
    if [str.eq typ, 'int' or str.eq typ, 'char' or str.eq typ, 'bool'] [
        str iv = intify loaded, typ
        str out = new_reg 0
        str call = str.concat out, ' = call ptr @luna_int_str(i32 '
        call = str.concat call, iv
        call = str.concat call, ')'
        emit_inst call
        = out
    ]
    fail 'unsupported io.print interpolation type'
    = string_const ''
]

fn emit_print_stmt [int unused] int [
    expect_id 'io'
    expect_kind 'dot'
    expect_id 'print'
    if [not str.eq g_kind, 'str'] [
        = fail 'io.print currently expects a string literal'
    ]

    str text = g_text
    next_tok 0
    str out = string_const ''
    int n = str.len text
    int i = 0
    int segment = 0

    while [i lt n] [
        if [str.at text, i eq 91] [
            if [i gt segment] [
                str literal = str.slice text, segment, i
                out = append_print_value out, string_const literal
            ]
            i = i add 1
            int start = i
            while [i lt n and str.at text, i ne 93] [ i = i add 1 ]
            if [i ge n] [ = fail 'unterminated io.print interpolation' ]
            str name = str.slice text, start, i
            str value = print_value_for_name name
            out = append_print_value out, value
            i = i add 1
            segment = i
        ]
        else [ i = i add 1 ]
    ]

    if [segment lt n] [
        str tail = str.slice text, segment, n
        out = append_print_value out, string_const tail
    ]

    str ps = str.concat 'call i32 @puts(ptr ', out
    ps = str.concat ps, ')'
    emit_inst ps
    = 0
]

fn parse_stmt_ir [int unused] int [
    skip_nl 0
    if [str.eq g_kind, 'id' and str.eq g_text, 'if'] [
        next_tok 0
        expect_kind 'lb'
        str cond = parse_expr 0
        str ct = g_expr_type
        cond = boolify cond, ct
        expect_kind 'rb'
        str yes = new_label 'if.then'
        str no = new_label 'if.else'
        str done = new_label 'if.end'
        emit_cbranch cond, yes, no
        emit_label yes
        parse_block_ir 0
        int yes_term = g_terminated
        if [yes_term eq 0] [ emit_branch done ]
        skip_nl 0
        if [str.eq g_kind, 'id' and str.eq g_text, 'else'] [
            next_tok 0
            emit_label no
            parse_block_ir 0
            int no_term = g_terminated
            if [no_term eq 0] [ emit_branch done ]
            emit_label done
            if [yes_term and no_term] [ emit_unreachable 0 ]
        ]
        else [
            emit_label no
            emit_branch done
            emit_label done
        ]
        = 0
    ]
    if [str.eq g_kind, 'id' and str.eq g_text, 'while'] [
        next_tok 0
        str cond_label = new_label 'while.cond'
        str body_label = new_label 'while.body'
        str end_label = new_label 'while.end'
        emit_branch cond_label
        emit_label cond_label
        expect_kind 'lb'
        str condw = parse_expr 0
        str cwt = g_expr_type
        condw = boolify condw, cwt
        expect_kind 'rb'
        emit_cbranch condw, body_label, end_label
        emit_label body_label
        str old_break = g_break_label
        str old_continue = g_continue_label
        g_break_label = end_label
        g_continue_label = cond_label
        parse_block_ir 0
        g_break_label = old_break
        g_continue_label = old_continue
        if [g_terminated eq 0] [ emit_branch cond_label ]
        emit_label end_label
        = 0
    ]
    if [str.eq g_kind, 'id' and str.eq g_text, 'break'] [
        next_tok 0
        emit_branch g_break_label
        = 0
    ]
    if [str.eq g_kind, 'id' and str.eq g_text, 'continue'] [
        next_tok 0
        emit_branch g_continue_label
        = 0
    ]
    if [str.eq g_kind, 'assign'] [
        next_tok 0
        if [str.eq g_kind, 'id' and str.eq g_text, 'match'] [
            = emit_match_return g_current_ret
        ]
        str rv = parse_expr 0
        str rt = g_expr_type
        rv = cast_value rv, rt, g_current_ret
        emit_return g_current_ret, rv
        = 0
    ]
    if [str.eq g_kind, 'id' and str.eq g_text, 'return'] [
        next_tok 0
        if [str.eq g_kind, 'id' and str.eq g_text, 'match'] [
            = emit_match_return g_current_ret
        ]
        str rv2 = parse_expr 0
        str rt2 = g_expr_type
        rv2 = cast_value rv2, rt2, g_current_ret
        emit_return g_current_ret, rv2
        = 0
    ]
    if [str.eq g_kind, 'id' and is_decl_type g_text] [
        = parse_decl_ir 0
    ]
    if [str.eq g_kind, 'id' and str.eq g_text, 'io'] [
        = emit_print_stmt 0
    ]
    if [str.eq g_kind, 'id' and str.eq g_text, 'sys'] [
        str ignored = emit_sys_memory 'ptr int'
        = 0
    ]
    str lhs = parse_expr 0
    str lhs_type = g_expr_type
    str lhs_addr = g_expr_addr
    if [str.eq g_kind, 'assign'] [
        next_tok 0
        str rhs = ''
        if [str.eq g_kind, 'id' and str.eq g_text, 'sys'] [
            rhs = emit_sys_memory lhs_type
        ]
        else [
            rhs = parse_expr 0
        ]
        str rhs_type = g_expr_type
        rhs = cast_value rhs, rhs_type, lhs_type
        str st = str.concat 'store ', storage_type lhs_type
        st = str.concat st, ' '
        st = str.concat st, rhs
        st = str.concat st, ', ptr '
        st = str.concat st, lhs_addr
        emit_inst st
        = 0
    ]
    = 0
]

fn parse_block_ir [int unused] int [
    expect_kind 'lb'
    skip_nl 0
    while [not str.eq g_kind, 'rb' and not str.eq g_kind, 'eof'] [
        parse_stmt_ir 0
        skip_nl 0
    ]
    expect_kind 'rb'
    = 0
]

fn skip_block [int unused] int [
    expect_kind 'lb'
    int depth = 1
    while [depth gt 0 and not str.eq g_kind, 'eof'] [
        if [str.eq g_kind, 'lb'] [ depth = depth add 1 ]
        if [str.eq g_kind, 'rb'] [ depth = depth sub 1 ]
        next_tok 0
    ]
    = 0
]

fn scan_struct [int unused] int [
    expect_id 'struct'
    str name = g_text
    next_tok 0
    expect_kind 'lb'
    skip_nl 0
    int index = 0
    while [not str.eq g_kind, 'rb' and not str.eq g_kind, 'eof'] [
        str typ = parse_type 0
        str field = g_text
        next_tok 0
        str key = struct_key name, field
        g_struct_indices = map_put g_struct_indices, key, int.str index
        g_struct_types = map_put g_struct_types, key, typ
        index = index add 1
        skip_nl 0
    ]
    expect_kind 'rb'
    g_struct_counts = map_put g_struct_counts, name, int.str index
    = 0
]

fn scan_function [int unused] int [
    expect_id 'fn'
    str name = g_text
    next_tok 0
    expect_kind 'lb'
    int argc = 0
    while [not str.eq g_kind, 'rb'] [
        str typ = parse_type 0
        str pname = g_text
        next_tok 0
        str pkey = fn_param_key name, argc
        g_fn_params = map_put g_fn_params, pkey, typ
        argc = argc add 1
        if [str.eq g_kind, 'comma'] [ next_tok 0 ]
        else [ break ]
    ]
    expect_kind 'rb'
    str ret = 'int'
    if [str.eq g_kind, 'id'] [
        ret = g_text
        next_tok 0
    ]
    g_fn_ret = map_put g_fn_ret, name, ret
    g_fn_argc = map_put g_fn_argc, name, int.str argc
    skip_block 0
    = 0
]

fn scan_global [int unused] int [
    str typ = parse_type 0
    str name = g_text
    next_tok 0
    expect_kind 'assign'
    g_globals = map_put g_globals, name, typ
    while [not str.eq g_kind, 'nl' and not str.eq g_kind, 'eof'] [ next_tok 0 ]
    = 0
]

fn scan_top [str source] int [
    g_globals = ''
    g_fn_ret = ''
    g_fn_argc = ''
    g_fn_params = ''
    g_struct_counts = ''
    g_struct_indices = ''
    g_struct_types = ''
    reset source
    skip_nl 0
    while [not str.eq g_kind, 'eof'] [
        if [str.eq g_kind, 'id' and str.eq g_text, 'use'] [
            next_tok 0
            next_tok 0
        ]
        else [
            if [str.eq g_kind, 'id' and str.eq g_text, 'struct'] [ scan_struct 0 ]
            else [
                if [str.eq g_kind, 'id' and str.eq g_text, 'fn'] [ scan_function 0 ]
                else [
                    if [str.eq g_kind, 'id' and is_decl_type g_text] [ scan_global 0 ]
                    else [ = fail 'unsupported top level item' ]
                ]
            ]
        ]
        skip_nl 0
    ]
    = 0
]

fn emit_struct_ir [int unused] int [
    expect_id 'struct'
    str name = g_text
    next_tok 0
    expect_kind 'lb'
    skip_nl 0
    str fields = ''
    int first = 1
    while [not str.eq g_kind, 'rb' and not str.eq g_kind, 'eof'] [
        str typ = parse_type 0
        next_tok 0
        if [first eq 0] [ fields = str.concat fields, ', ' ]
        fields = str.concat fields, storage_type typ
        first = 0
        skip_nl 0
    ]
    expect_kind 'rb'
    str s = str.concat '%struct.', name
    s = str.concat s, ' = type { '
    s = str.concat s, fields
    s = str.concat s, ' }'
    emit_line s
    emit_line ''
    = 0
]

fn emit_global_ir [int unused] int [
    str typ = parse_type 0
    str name = g_text
    next_tok 0
    expect_kind 'assign'
    str value = '0'
    if [str.eq g_kind, 'str'] [ value = string_const g_text ]
    else [ value = g_text ]
    next_tok 0
    str s = str.concat '@', name
    s = str.concat s, ' = global '
    s = str.concat s, storage_type typ
    s = str.concat s, ' '
    s = str.concat s, value
    emit_line s
    = 0
]

fn emit_function_ir [int unused] int [
    expect_id 'fn'
    str name = g_text
    next_tok 0
    expect_kind 'lb'
    str args = ''
    str prologue = ''
    g_locals = ''
    g_local_addrs = ''
    g_temp = 0
    int first = 1
    while [not str.eq g_kind, 'rb'] [
        str typ = parse_type 0
        str pname = g_text
        next_tok 0
        g_locals = map_put g_locals, pname, typ
        str paddr = new_reg 0
        g_local_addrs = map_put g_local_addrs, pname, paddr
        if [first eq 0] [ args = str.concat args, ', ' ]
        args = str.concat args, storage_type typ
        args = str.concat args, ' %arg.'
        args = str.concat args, pname
        str p1 = str.concat '  ', paddr
        p1 = str.concat p1, ' = alloca '
        p1 = str.concat p1, storage_type typ
        prologue = str.concat prologue, p1
        prologue = str.concat prologue, str.chr 10
        str p2 = str.concat '  store ', storage_type typ
        p2 = str.concat p2, ' %arg.'
        p2 = str.concat p2, pname
        p2 = str.concat p2, ', ptr '
        p2 = str.concat p2, paddr
        prologue = str.concat prologue, p2
        prologue = str.concat prologue, str.chr 10
        first = 0
        if [str.eq g_kind, 'comma'] [ next_tok 0 ]
        else [ break ]
    ]
    expect_kind 'rb'
    str ret = 'int'
    if [str.eq g_kind, 'id'] [
        ret = g_text
        next_tok 0
    ]
    g_current_ret = ret
    g_label = 0
    g_terminated = 0
    g_break_label = ''
    g_continue_label = ''
    str head = str.concat 'define ', storage_type ret
    head = str.concat head, ' @'
    head = str.concat head, name
    head = str.concat head, '('
    head = str.concat head, args
    head = str.concat head, ') {'
    emit_line head
    emit_label 'entry'
    g_out = str.concat g_out, prologue
    parse_block_ir 0
    if [g_terminated eq 0] [ emit_return ret, default_value ret ]
    emit_line '}'
    emit_line ''
    = 0
]

fn emit_header [int unused] int [
    emit_line '; Luna self-hosted LLVM backend'
    emit_line ''
    emit_line 'declare ptr @luna_read_text(ptr)'
    emit_line 'declare i32 @luna_write_text(ptr, ptr)'
    emit_line 'declare i32 @luna_str_len(ptr)'
    emit_line 'declare i32 @luna_str_at(ptr, i32)'
    emit_line 'declare ptr @luna_str_slice(ptr, i32, i32)'
    emit_line 'declare ptr @luna_str_concat(ptr, ptr)'
    emit_line 'declare i32 @luna_str_eq(ptr, ptr)'
    emit_line 'declare i32 @luna_str_starts(ptr, ptr)'
    emit_line 'declare ptr @luna_str_trim(ptr)'
    emit_line 'declare ptr @luna_str_chr(i32)'
    emit_line 'declare ptr @luna_int_str(i32)'
    emit_line 'declare ptr @malloc(i64)'
    emit_line 'declare ptr @realloc(ptr, i64)'
    emit_line 'declare void @free(ptr)'
    emit_line 'declare i32 @puts(ptr)'
    emit_line ''
    = 0
]

fn compile_llvm [str source] str [
    g_error = 0
    g_out = ''
    g_strings = ''
    g_string_id = 0
    scan_top source
    emit_header 0
    reset source
    skip_nl 0
    while [not str.eq g_kind, 'eof'] [
        if [str.eq g_kind, 'id' and str.eq g_text, 'use'] [
            next_tok 0
            next_tok 0
        ]
        else [
            if [str.eq g_kind, 'id' and str.eq g_text, 'struct'] [ emit_struct_ir 0 ]
            else [
                if [str.eq g_kind, 'id' and str.eq g_text, 'fn'] [ emit_function_ir 0 ]
                else [
                    if [str.eq g_kind, 'id' and is_decl_type g_text] [ emit_global_ir 0 ]
                    else [
                        fail 'unsupported top level item'
                        = ''
                    ]
                ]
            ]
        ]
        skip_nl 0
    ]
    g_out = str.concat g_out, g_strings
    = g_out
]

fn main [int argc, ptr str argv] int [
    if [argc lt 3] [ = 2 ]
    str source = io.read_text argv[1]
    str ir = compile_llvm source
    if [g_error] [ = 1 ]
    int ok = io.write_text argv[2], ir
    if [ok eq 0] [ = 1 ]
    = 0
]
